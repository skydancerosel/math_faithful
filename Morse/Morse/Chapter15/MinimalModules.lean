import Morse.Chapter15.CliffordModules

/-!
Milnor, *Morse Theory*, §24, p. 143: Lemma 24.8 (Bott–Shapiro).

# Minimal Clifford modules: dimension and uniqueness

## Milnor's text, paraphrased

* **Definition** (p. 143).  A `(J_1, …, J_k)`-space is *minimal* if no proper non-trivial
  subspace is closed under `J_1, …, J_k`; two minimal spaces are *isomorphic* if there is an
  isometry between them commuting with `J_1, …, J_k`.
* **Lemma 24.8** (Bott–Shapiro).  For `k ≢ 3 (mod 4)` any two minimal `(J_1, …, J_k)`-spaces are
  isomorphic.  "The proof of 24.8 follows that of 24.6": for `k = 3` the minimal spaces are
  quaternionic lines with `J_3 = ±J_1J_2` (two classes `H`, `H'`), for `k = 7` there are two
  classes `L`, `L'` with `J_7 = ±J_1⋯J_6`, and the dimension `m_k` of a minimal space is
  `1, 2, 4, 4, 8, 8, 8, 8, 16` for `k = 0, …, 8`.

## What is formalized

For a finite-dimensional real vector space `V` with `J : ℕ → Module.End ℝ V` satisfying the
relations `Morse.IsClifford J k` (no inner product is used):

* **`Morse.finrank_eq_milnorM_of_isMinimal`**: for `k ≤ 8`, every minimal `(J_1, …, J_k)`-space
  has dimension exactly `m_k`.
* **`Morse.exists_iso_of_isMinimal`** (Lemma 24.8): for `k ≤ 8` and `k ≢ 3 (mod 4)`, any two
  minimal spaces are isomorphic by a *linear* isomorphism commuting with every `J_α`.

The method replaces Milnor's appeal to "the proof of 24.6".  Let `C_k` be the Clifford algebra
(`Morse.cliffQ`, Mathlib's `CliffordAlgebra`, `dim C_k = 2^k`) and `u ∈ V` a non-zero joint
`+1`-eigenvector of the involutions `θ₃, θ₅, θ₆, θ₇` available for `k`
(`Morse/Chapter15/CliffordModules.lean` shows the joint eigenspace is a non-zero `1/2^t` of `V`).
The orbit map `c ↦ c·u` (`Morse.cyclicMap`) is onto a minimal `V` (`Morse.range_cyclicMap_eq_top`)
and factors through the subspace `F ⊆ C_k` of elements fixed by right multiplication by the
`θ`'s (`Morse.exists_fixed`, `Morse.map_cyclicMap_eq_top`).  Right multiplications by `−e_α`
again satisfy the Clifford relations (`Morse.isClifford_cliffR`), so the halving chain of
`Morse/Chapter15/CliffordModules.lean`, applied to `C_k` itself, gives `dim F = 2^k/2^t = m_k`
for `k = 4, 5, 6, 8` (`Morse.minimal_four`, …, `Morse.minimal_eight`); with `m_k ∣ dim V` this
forces `dim V = m_k` and `F ≅ V`.  For `k ≤ 2` there is nothing to fix: `V ≅ C_k`
(`Morse.minimal_le_two`).  For `k = 3, 7` the central involution `ω_k = J_1⋯J_k` acts as `±1`
on a minimal space (`Morse.central_involution`, Milnor's `J_3 = ±J_1J_2`, `J_7 = ±J_1⋯J_6`),
so it is a minimal space for `k − 1` structures (`Morse.minimal_three`, `Morse.minimal_seven`).
Two minimal spaces isomorphic to the same left ideal `F` are isomorphic to each other
(`Morse.exists_iso_of_equiv`).

Not formalized: the isometric version of the isomorphism (Milnor's definition asks for an
isometry; for orthogonal `J_α` it follows from the linear one by polar decomposition), that for
`k = 3, 7` there are exactly two classes, and the case `k > 8`.

## Gaps in Milnor's text

* p. 143, "the proof of 24.8 follows that of 24.6": 24.6 describes the spaces `Ω_k(16r)`, not
  minimal modules; what carries over is the splitting by the involutions `θ`.  Uniqueness needs
  in addition a cyclic-vector argument (a minimal space is generated by one joint eigenvector),
  which here is the orbit map from `C_k`.
* p. 143, "for `k = 3` a minimal space is still a 1-dimensional vector space over the
  quaternions": this uses that `J_1J_2J_3` commutes with everything and squares to `+1`, hence is
  `±1` on a minimal space (`Morse.central_involution`).
-/

open Module Finset

noncomputable section

namespace Morse

/-- The generators `e_1, …, e_k` of `C_k` (`e_α = 0` for `α ∉ [1, k]`). -/
def cliffE (k : ℕ) (α : ℕ) : CliffordAlgebra (cliffQ k) :=
  if h : 1 ≤ α ∧ α ≤ k then CliffordAlgebra.ι (cliffQ k) (Pi.single (⟨α - 1, by omega⟩ : Fin k) 1)
  else 0

theorem cliffQ_single (k : ℕ) (i : Fin k) : cliffQ k (Pi.single i 1) = -1 := by
  rw [cliffQ_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj; simp [hj]
  · simp

theorem cliffQ_single_add (k : ℕ) {i j : Fin k} (hij : i ≠ j) :
    cliffQ k (Pi.single i 1 + Pi.single j 1) = -2 := by
  rw [cliffQ_apply]
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i), ← Finset.sum_erase_add _ _
    (Finset.mem_erase.2 ⟨hij.symm, Finset.mem_univ j⟩), Finset.sum_eq_zero]
  · simp [hij, hij.symm]; norm_num
  · intro l hl
    simp only [Finset.mem_erase] at hl
    simp [hl.1, hl.2.1]

theorem isClifford_cliffE (k : ℕ) : IsClifford (cliffE k) k := by
  refine ⟨fun a h1 h2 => ?_, fun a b h1 h2 h3 h4 hab => ?_⟩
  · rw [cliffE, dif_pos ⟨h1, h2⟩, CliffordAlgebra.ι_sq_scalar, cliffQ_single, map_neg, map_one]
  · rw [cliffE, cliffE, dif_pos ⟨h1, h2⟩, dif_pos ⟨h3, h4⟩]
    have hne : (⟨a - 1, by omega⟩ : Fin k) ≠ ⟨b - 1, by omega⟩ := fun h => hab (by
      have := congrArg Fin.val h; simp at this; omega)
    have := CliffordAlgebra.ι_mul_ι_add_swap (Q := cliffQ k)
      (Pi.single (⟨a - 1, by omega⟩ : Fin k) 1) (Pi.single (⟨b - 1, by omega⟩ : Fin k) 1)
    rw [QuadraticMap.polar, cliffQ_single_add k hne, cliffQ_single, cliffQ_single] at this
    norm_num at this
    exact eq_neg_of_add_eq_zero_left this


variable {k : ℕ}

/-- Right multiplication by `−e_α` on `C_k`: again anticommuting square roots of `−1`
(`Morse.isClifford_cliffR`), whose `θ`'s are the right multiplications by the `θ`'s of `C_k`. -/
def cliffR (k : ℕ) (α : ℕ) : Module.End ℝ (CliffordAlgebra (cliffQ k)) :=
  -LinearMap.mulRight ℝ (cliffE k α)

theorem cliffR_mul (α β : ℕ) :
    cliffR k α * cliffR k β = LinearMap.mulRight ℝ (cliffE k β * cliffE k α) := by
  ext c; simp [cliffR, mul_assoc]

theorem isClifford_cliffR (k : ℕ) : IsClifford (cliffR k) k := by
  have h := isClifford_cliffE k
  refine ⟨fun a h1 h2 => ?_, fun a b h1 h2 h3 h4 hab => ?_⟩
  · rw [cliffR_mul, h.sq a h1 h2]
    ext c; simp
  · rw [cliffR_mul, cliffR_mul, h.anti b a h3 h4 h1 h2 (Ne.symm hab)]
    ext c; simp [mul_assoc]

/-- The `θ`'s of the right multiplications are the right multiplications by the `θ`'s of
`C_k`. -/
theorem θ₃_cliffR (hk : 3 ≤ k) : θ₃ (cliffR k) = LinearMap.mulRight ℝ (θ₃ (cliffE k)) := by
  have h := (isClifford_cliffE k).mono hk
  unfold θ₃
  ext c
  simp only [Module.End.mul_apply, cliffR, LinearMap.neg_apply, LinearMap.mulRight_apply, map_neg,
    neg_neg]
  clifford_simp h


theorem θ₅_cliffR (hk : 5 ≤ k) : θ₅ (cliffR k) = LinearMap.mulRight ℝ (θ₅ (cliffE k)) := by
  have h := (isClifford_cliffE k).mono hk
  unfold θ₅
  ext c
  simp only [Module.End.mul_apply, cliffR, LinearMap.neg_apply, LinearMap.mulRight_apply, map_neg,
    neg_neg]
  clifford_simp h

theorem θ₆_cliffR (hk : 6 ≤ k) : θ₆ (cliffR k) = LinearMap.mulRight ℝ (θ₆ (cliffE k)) := by
  have h := (isClifford_cliffE k).mono hk
  unfold θ₆
  ext c
  simp only [Module.End.mul_apply, cliffR, LinearMap.neg_apply, LinearMap.mulRight_apply, map_neg,
    neg_neg]
  clifford_simp h

theorem θ₇_cliffR (hk : 7 ≤ k) : θ₇ (cliffR k) = LinearMap.mulRight ℝ (θ₇ (cliffE k)) := by
  have h := (isClifford_cliffE k).mono hk
  unfold θ₇
  ext c
  simp only [Module.End.mul_apply, cliffR, LinearMap.neg_apply, LinearMap.mulRight_apply, map_neg,
    neg_neg]
  clifford_simp h

theorem mem_ker_mulRight_sub_one {θ c : CliffordAlgebra (cliffQ k)} :
    c ∈ LinearMap.ker (LinearMap.mulRight ℝ θ - 1) ↔ c * θ = c := by
  simp [sub_eq_zero]

/-- If `Φ` is invariant under right multiplication by commuting involutions `θ`, every value of
`Φ` is taken at an element fixed by all the `θ`'s (multiply by the idempotents `(1 + θ)/2`). -/
theorem exists_fixed {W : Type*} [AddCommGroup W] [Module ℝ W]
    (Φ : CliffordAlgebra (cliffQ k) →ₗ[ℝ] W) (θs : List (CliffordAlgebra (cliffQ k)))
    (hsq : ∀ θ ∈ θs, θ * θ = 1) (hcomm : θs.Pairwise Commute)
    (hΦ : ∀ θ ∈ θs, ∀ c, Φ (c * θ) = Φ c) (c : CliffordAlgebra (cliffQ k)) :
    ∃ c', Φ c' = Φ c ∧ ∀ θ ∈ θs, c' * θ = c' := by
  induction θs with
  | nil => exact ⟨c, rfl, by simp⟩
  | cons θ rest ih =>
    rw [List.pairwise_cons] at hcomm
    obtain ⟨c'', hΦc, hfix⟩ := ih (fun t ht => hsq t (List.mem_cons_of_mem _ ht)) hcomm.2
      (fun t ht => hΦ t (List.mem_cons_of_mem _ ht))
    set p : CliffordAlgebra (cliffQ k) := (1 / 2 : ℝ) • (1 + θ) with hp
    have hθθ := hsq θ (List.mem_cons_self ..)
    refine ⟨c'' * p, ?_, ?_⟩
    · rw [hp, mul_smul_comm, mul_add, mul_one, map_smul, map_add, hΦ θ (List.mem_cons_self ..),
        hΦc, ← two_smul ℝ (Φ c), smul_smul]
      norm_num
    · intro t ht
      rcases List.mem_cons.1 ht with rfl | ht
      · rw [hp, mul_assoc, smul_mul_assoc, add_mul, one_mul, hθθ, add_comm]
      · have hct : Commute θ t := hcomm.1 t ht
        have hpt : p * t = t * p := by
          rw [hp, smul_mul_assoc, mul_smul_comm, add_mul, mul_add, one_mul, mul_one, hct.eq]
        rw [mul_assoc, hpt, ← mul_assoc, hfix t ht]


theorem mem_of_fixed_mul {F : Submodule ℝ (CliffordAlgebra (cliffQ k))}
    {θ : CliffordAlgebra (cliffQ k)} (hF : ∀ c, c ∈ F ↔ c * θ = c) (a : CliffordAlgebra (cliffQ k))
    {c : CliffordAlgebra (cliffQ k)} (hc : c ∈ F) : a * c ∈ F := by
  rw [hF] at hc ⊢; rw [mul_assoc, hc]

theorem ker_mulRight_mul {θ : CliffordAlgebra (cliffQ k)} (a : CliffordAlgebra (cliffQ k))
    {c : CliffordAlgebra (cliffQ k)} (hc : c ∈ LinearMap.ker (LinearMap.mulRight ℝ θ - 1)) :
    a * c ∈ LinearMap.ker (LinearMap.mulRight ℝ θ - 1) :=
  mem_of_fixed_mul (fun _ => mem_ker_mulRight_sub_one) a hc

section Minimal

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The orbit map `c ↦ c · u` of a `(J_1, …, J_k)`-space, `C_k`-linear. -/
def cyclicMap {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (u : V) :
    CliffordAlgebra (cliffQ k) →ₗ[ℝ] V :=
  (LinearMap.applyₗ u) ∘ₗ (cliffordLift h).toLinearMap

theorem cyclicMap_apply {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (u : V)
    (c : CliffordAlgebra (cliffQ k)) : cyclicMap h u c = cliffordLift h c u := rfl

theorem cliffordLift_cliffE {J : ℕ → Module.End ℝ V} (h : IsClifford J k) {α : ℕ} (h1 : 1 ≤ α)
    (h2 : α ≤ k) : cliffordLift h (cliffE k α) = J α := by
  rw [cliffE, dif_pos ⟨h1, h2⟩, cliffordLift_ι]
  congr 1
  simp only
  omega

theorem cyclicMap_mul {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (u : V) {α : ℕ}
    (h1 : 1 ≤ α) (h2 : α ≤ k) (c : CliffordAlgebra (cliffQ k)) :
    cyclicMap h u (cliffE k α * c) = J α (cyclicMap h u c) := by
  rw [cyclicMap_apply, cyclicMap_apply, map_mul, cliffordLift_cliffE h h1 h2,
    Module.End.mul_apply]

theorem range_cyclicMap_eq_top {J : ℕ → Module.End ℝ V} (h : IsClifford J k)
    (hmin : IsMinimalCliffordModule J k) {u : V} (hu : u ≠ 0) :
    LinearMap.range (cyclicMap h u) = ⊤ := by
  rcases hmin.2 (LinearMap.range (cyclicMap h u)) (fun α h1 h2 w hw => by
      obtain ⟨c, rfl⟩ := LinearMap.mem_range.1 hw
      exact ⟨cliffE k α * c, cyclicMap_mul h u h1 h2 c⟩) with hbot | htop
  · exfalso
    have : u ∈ LinearMap.range (cyclicMap h u) :=
      ⟨1, by rw [cyclicMap_apply, map_one, Module.End.one_apply]⟩
    rw [hbot, Submodule.mem_bot] at this
    exact hu this
  · exact htop

/-- If `u` is fixed by the `θ`'s, a minimal space is the image of the subspace `F` of `C_k` fixed
by them under right multiplication. -/
theorem map_cyclicMap_eq_top {J : ℕ → Module.End ℝ V} (h : IsClifford J k)
    (hmin : IsMinimalCliffordModule J k) {u : V} (hu : u ≠ 0)
    (θs : List (CliffordAlgebra (cliffQ k))) (hsq : ∀ θ ∈ θs, θ * θ = 1)
    (hcomm : θs.Pairwise Commute) (hfix : ∀ θ ∈ θs, cliffordLift h θ u = u)
    (F : Submodule ℝ (CliffordAlgebra (cliffQ k))) (hF : ∀ c, c ∈ F ↔ ∀ θ ∈ θs, c * θ = c) :
    Submodule.map (cyclicMap h u) F = ⊤ := by
  rw [eq_top_iff, ← range_cyclicMap_eq_top h hmin hu]
  rintro _ ⟨c, rfl⟩
  obtain ⟨c', hc', hfix'⟩ := exists_fixed (cyclicMap h u) θs hsq hcomm
    (fun θ hθ c => by rw [cyclicMap_apply, cyclicMap_apply, map_mul, Module.End.mul_apply,
      hfix θ hθ]) c
  exact ⟨c', (hF c').2 hfix', hc'⟩

theorem finrank_le_of_fixed [FiniteDimensional ℝ V] {J : ℕ → Module.End ℝ V} (h : IsClifford J k)
    (hmin : IsMinimalCliffordModule J k) {u : V} (hu : u ≠ 0)
    (θs : List (CliffordAlgebra (cliffQ k))) (hsq : ∀ θ ∈ θs, θ * θ = 1)
    (hcomm : θs.Pairwise Commute) (hfix : ∀ θ ∈ θs, cliffordLift h θ u = u)
    (F : Submodule ℝ (CliffordAlgebra (cliffQ k))) (hF : ∀ c, c ∈ F ↔ ∀ θ ∈ θs, c * θ = c) :
    finrank ℝ V ≤ finrank ℝ F := by
  rw [← finrank_top ℝ V, ← map_cyclicMap_eq_top h hmin hu θs hsq hcomm hfix F hF]
  exact Submodule.finrank_map_le _ _

/-- When the dimensions agree, `c ↦ c · u` is an isomorphism `F ≅ V`. -/
theorem exists_linearEquiv_of_fixed [FiniteDimensional ℝ V] {J : ℕ → Module.End ℝ V}
    (h : IsClifford J k) (hmin : IsMinimalCliffordModule J k) {u : V} (hu : u ≠ 0)
    (θs : List (CliffordAlgebra (cliffQ k))) (hsq : ∀ θ ∈ θs, θ * θ = 1)
    (hcomm : θs.Pairwise Commute) (hfix : ∀ θ ∈ θs, cliffordLift h θ u = u)
    (F : Submodule ℝ (CliffordAlgebra (cliffQ k))) (hF : ∀ c, c ∈ F ↔ ∀ θ ∈ θs, c * θ = c)
    (hdim : finrank ℝ F = finrank ℝ V) :
    ∃ e : F ≃ₗ[ℝ] V, ∀ c : F, e c = cliffordLift h c u := by
  set Φ : F →ₗ[ℝ] V := cyclicMap h u ∘ₗ F.subtype
  have hsurj : Function.Surjective Φ := by
    rw [← LinearMap.range_eq_top]
    rw [LinearMap.range_comp, Submodule.range_subtype]
    exact map_cyclicMap_eq_top h hmin hu θs hsq hcomm hfix F hF
  have hinj : Function.Injective Φ :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).2 hsurj
  exact ⟨LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩, fun c => rfl⟩


theorem cliffordLift_θ₃ {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : 3 ≤ k) :
    cliffordLift h (θ₃ (cliffE k)) = θ₃ J := by
  simp only [θ₃, map_mul, cliffordLift_cliffE h (by norm_num : 1 ≤ 1) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 2) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 3) (by omega)]

theorem cliffordLift_θ₅ {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : 5 ≤ k) :
    cliffordLift h (θ₅ (cliffE k)) = θ₅ J := by
  simp only [θ₅, map_mul, cliffordLift_cliffE h (by norm_num : 1 ≤ 1) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 4) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 5) (by omega)]

theorem cliffordLift_θ₆ {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : 6 ≤ k) :
    cliffordLift h (θ₆ (cliffE k)) = θ₆ J := by
  simp only [θ₆, map_mul, cliffordLift_cliffE h (by norm_num : 1 ≤ 2) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 4) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 6) (by omega)]

theorem cliffordLift_θ₇ {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : 7 ≤ k) :
    cliffordLift h (θ₇ (cliffE k)) = θ₇ J := by
  simp only [θ₇, map_mul, cliffordLift_cliffE h (by norm_num : 1 ≤ 1) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 6) (by omega),
    cliffordLift_cliffE h (by norm_num : 1 ≤ 7) (by omega)]

variable [FiniteDimensional ℝ V]

theorem exists_ne_zero_mem {W : Submodule ℝ V} (hW : 0 < finrank ℝ W) : ∃ u ∈ W, u ≠ 0 := by
  obtain ⟨⟨u, hu⟩, hne⟩ := Module.finrank_pos_iff_exists_ne_zero.1 hW
  exact ⟨u, hu, fun h => hne (Subtype.ext h)⟩

/-- The general step: if `u ≠ 0` is fixed by commuting involutions `θ(J)`, and the subspace `F`
of `C_k` fixed by the `θ`'s on the right has dimension `m_k`, then a minimal space has dimension
`m_k` and `c ↦ c·u` is an isomorphism `F ≅ V`. -/
theorem minimal_of_fixed {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : k ≤ 8)
    (hmin : IsMinimalCliffordModule J k) (θs : List (CliffordAlgebra (cliffQ k)))
    (hsq : ∀ θ ∈ θs, θ * θ = 1) (hcomm : θs.Pairwise Commute)
    (F : Submodule ℝ (CliffordAlgebra (cliffQ k))) (hF : ∀ c, c ∈ F ↔ ∀ θ ∈ θs, c * θ = c)
    (hFdim : finrank ℝ F = milnorM k) {u : V} (hu0 : u ≠ 0)
    (hfix : ∀ θ ∈ θs, cliffordLift h θ u = u) :
    finrank ℝ V = milnorM k ∧ ∃ e : F ≃ₗ[ℝ] V, ∀ c : F, e c = cliffordLift h c u := by
  have := hmin.1
  have hle := finrank_le_of_fixed h hmin hu0 θs hsq hcomm hfix F hF
  have hge : milnorM k ≤ finrank ℝ V :=
    Nat.le_of_dvd Module.finrank_pos (milnorM_dvd_finrank hk h)
  have hdim : finrank ℝ V = milnorM k := by omega
  exact ⟨hdim, exists_linearEquiv_of_fixed h hmin hu0 θs hsq hcomm hfix F hF (by omega)⟩

/-- The fixed space for `k ≤ 2`: all of `C_k`. -/
theorem minimal_le_two {J : ℕ → Module.End ℝ V} (h : IsClifford J k) (hk : k ≤ 2)
    (hmin : IsMinimalCliffordModule J k) :
    finrank ℝ V = milnorM k ∧ ∃ u : V, ∃ e : (⊤ : Submodule ℝ (CliffordAlgebra (cliffQ k))) ≃ₗ[ℝ] V,
      ∀ c, e c = cliffordLift h c u := by
  have := hmin.1
  obtain ⟨u, hu0⟩ := exists_ne (0 : V)
  have hFdim : finrank ℝ (⊤ : Submodule ℝ (CliffordAlgebra (cliffQ k))) = milnorM k := by
    rw [finrank_top, finrank_cliffordAlgebra]
    interval_cases k <;> rfl
  obtain ⟨hd, e, he⟩ := minimal_of_fixed h (hk.trans (by norm_num)) hmin [] (by simp) (by simp) ⊤
    (by simp) hFdim hu0 (by simp)
  exact ⟨hd, u, e, he⟩

/-- `k = 4`: the fixed space of `θ₃`. -/
theorem minimal_four {J : ℕ → Module.End ℝ V} (h : IsClifford J 4)
    (hmin : IsMinimalCliffordModule J 4) :
    finrank ℝ V = 8 ∧ ∃ u : V, ∃ e : eigV₁ (cliffR 4) ≃ₗ[ℝ] V,
      ∀ c, e c = cliffordLift h c u := by
  have := hmin.1
  have hE := isClifford_cliffE 4
  obtain ⟨h3sq, -, -, -⟩ := θ₃_spec (hE.mono (by norm_num))
  have hF : ∀ c, c ∈ eigV₁ (cliffR 4) ↔ ∀ θ ∈ [θ₃ (cliffE 4)], c * θ = c := by
    intro c
    simp [eigV₁, θ₃_cliffR (by norm_num : 3 ≤ 4), sub_eq_zero]
  have hFdim : finrank ℝ (eigV₁ (cliffR 4)) = milnorM 4 := by
    have := finrank_eq_two_mul_eigV₁ (isClifford_cliffR 4)
    rw [finrank_cliffordAlgebra] at this
    change _ = 8
    omega
  have hVpos : 0 < finrank ℝ (eigV₁ J) := by
    have h1 := finrank_eq_two_mul_eigV₁ h
    have h2 : 0 < finrank ℝ V := Module.finrank_pos
    omega
  obtain ⟨u, hu, hu0⟩ := exists_ne_zero_mem hVpos
  have hfix : ∀ θ ∈ [θ₃ (cliffE 4)], cliffordLift h θ u = u := by
    simp only [List.mem_singleton, forall_eq]
    rw [cliffordLift_θ₃ h (by norm_num)]
    exact (mem_ker_sub_one_iff _ _).1 hu
  obtain ⟨hd, e, he⟩ := minimal_of_fixed h (by norm_num) hmin [θ₃ (cliffE 4)]
    (by simpa using h3sq) (by simp) _ hF hFdim hu0 hfix
  exact ⟨hd, u, e, he⟩


/-- `k = 5`: the fixed space of `θ₃, θ₅`. -/
theorem minimal_five {J : ℕ → Module.End ℝ V} (h : IsClifford J 5)
    (hmin : IsMinimalCliffordModule J 5) :
    finrank ℝ V = 8 ∧ ∃ u : V, ∃ e : eigW (cliffR 5) ≃ₗ[ℝ] V,
      ∀ c, e c = cliffordLift h c u := by
  have := hmin.1
  have hE := isClifford_cliffE 5
  obtain ⟨h3sq, -, -, -⟩ := θ₃_spec (hE.mono (by norm_num))
  obtain ⟨h5sq, -, -, -, -, -, h53⟩ := θ₅_spec hE
  have hF : ∀ c, c ∈ eigW (cliffR 5) ↔ ∀ θ ∈ [θ₃ (cliffE 5), θ₅ (cliffE 5)], c * θ = c := by
    intro c
    simp [eigW, eigV₁, θ₃_cliffR (by norm_num : 3 ≤ 5), θ₅_cliffR (by norm_num : 5 ≤ 5),
      sub_eq_zero]
  have hFdim : finrank ℝ (eigW (cliffR 5)) = milnorM 5 := by
    have h1 := finrank_eq_two_mul_eigV₁ ((isClifford_cliffR 5).mono (by norm_num))
    have h2 := finrank_eigV₁_eq (isClifford_cliffR 5)
    rw [finrank_cliffordAlgebra] at h1
    change _ = 8
    omega
  have hVpos : 0 < finrank ℝ (eigW J) := by
    have h1 := finrank_eq_two_mul_eigV₁ (h.mono (by norm_num))
    have h2 := finrank_eigV₁_eq h
    have h3 : 0 < finrank ℝ V := Module.finrank_pos
    omega
  obtain ⟨u, hu, hu0⟩ := exists_ne_zero_mem hVpos
  simp only [eigW, eigV₁, Submodule.mem_inf, mem_ker_sub_one_iff] at hu
  have hfix : ∀ θ ∈ [θ₃ (cliffE 5), θ₅ (cliffE 5)], cliffordLift h θ u = u := by
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    rintro θ (rfl | rfl)
    · rw [cliffordLift_θ₃ h (by norm_num)]; exact hu.1
    · rw [cliffordLift_θ₅ h (by norm_num)]; exact hu.2
  obtain ⟨hd, e, he⟩ := minimal_of_fixed h (by norm_num) hmin [θ₃ (cliffE 5), θ₅ (cliffE 5)]
    (by simp [h3sq, h5sq]) (by simpa using h53.symm) _ hF hFdim hu0 hfix
  exact ⟨hd, u, e, he⟩

/-- `k = 6`: the fixed space of `θ₃, θ₅, θ₆`. -/
theorem minimal_six {J : ℕ → Module.End ℝ V} (h : IsClifford J 6)
    (hmin : IsMinimalCliffordModule J 6) :
    finrank ℝ V = 8 ∧ ∃ u : V, ∃ e : eigX (cliffR 6) ≃ₗ[ℝ] V,
      ∀ c, e c = cliffordLift h c u := by
  have := hmin.1
  have hE := isClifford_cliffE 6
  obtain ⟨h3sq, -, -, -⟩ := θ₃_spec (hE.mono (by norm_num))
  obtain ⟨h5sq, -, -, -, -, -, h53⟩ := θ₅_spec (hE.mono (by norm_num))
  obtain ⟨h6sq, -, -, -, -, -, -, h63, h65⟩ := θ₆_spec hE
  have hF : ∀ c, c ∈ eigX (cliffR 6) ↔
      ∀ θ ∈ [θ₃ (cliffE 6), θ₅ (cliffE 6), θ₆ (cliffE 6)], c * θ = c := by
    intro c
    simp [eigX, eigW, eigV₁, θ₃_cliffR (by norm_num : 3 ≤ 6), θ₅_cliffR (by norm_num : 5 ≤ 6),
      θ₆_cliffR (by norm_num : 6 ≤ 6), sub_eq_zero, and_assoc]
  have hFdim : finrank ℝ (eigX (cliffR 6)) = milnorM 6 := by
    have h1 := finrank_eq_two_mul_eigV₁ ((isClifford_cliffR 6).mono (by norm_num))
    have h2 := finrank_eigV₁_eq ((isClifford_cliffR 6).mono (by norm_num))
    have h3 := finrank_eigW_eq (isClifford_cliffR 6)
    rw [finrank_cliffordAlgebra] at h1
    change _ = 8
    omega
  have hVpos : 0 < finrank ℝ (eigX J) := by
    have h1 := finrank_eq_two_mul_eigV₁ (h.mono (by norm_num))
    have h2 := finrank_eigV₁_eq (h.mono (by norm_num))
    have h3 := finrank_eigW_eq h
    have h4 : 0 < finrank ℝ V := Module.finrank_pos
    omega
  obtain ⟨u, hu, hu0⟩ := exists_ne_zero_mem hVpos
  simp only [eigX, eigW, eigV₁, Submodule.mem_inf, mem_ker_sub_one_iff] at hu
  have hfix : ∀ θ ∈ [θ₃ (cliffE 6), θ₅ (cliffE 6), θ₆ (cliffE 6)], cliffordLift h θ u = u := by
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    rintro θ (rfl | rfl | rfl)
    · rw [cliffordLift_θ₃ h (by norm_num)]; exact hu.1.1
    · rw [cliffordLift_θ₅ h (by norm_num)]; exact hu.1.2
    · rw [cliffordLift_θ₆ h (by norm_num)]; exact hu.2
  have hcomm : [θ₃ (cliffE 6), θ₅ (cliffE 6), θ₆ (cliffE 6)].Pairwise Commute := by
    simp only [List.pairwise_cons, List.mem_cons, List.not_mem_nil, or_false,
      forall_eq_or_imp, forall_eq, List.Pairwise.nil, and_true, IsEmpty.forall_iff, implies_true]
    exact ⟨⟨h53.symm, h63.symm⟩, h65.symm⟩
  obtain ⟨hd, e, he⟩ := minimal_of_fixed h (by norm_num) hmin _
    (by simp [h3sq, h5sq, h6sq]) hcomm _ hF hFdim hu0 hfix
  exact ⟨hd, u, e, he⟩

/-- `k = 8`: the fixed space of `θ₃, θ₅, θ₆, θ₇`. -/
theorem minimal_eight {J : ℕ → Module.End ℝ V} (h : IsClifford J 8)
    (hmin : IsMinimalCliffordModule J 8) :
    finrank ℝ V = 16 ∧ ∃ u : V, ∃ e : jointEigen (cliffR 8) ≃ₗ[ℝ] V,
      ∀ c, e c = cliffordLift h c u := by
  have := hmin.1
  have hE := isClifford_cliffE 8
  obtain ⟨h3sq, -, -, -⟩ := θ₃_spec (hE.mono (by norm_num))
  obtain ⟨h5sq, -, -, -, -, -, h53⟩ := θ₅_spec (hE.mono (by norm_num))
  obtain ⟨h6sq, -, -, -, -, -, -, h63, h65⟩ := θ₆_spec (hE.mono (by norm_num))
  obtain ⟨h7sq, -, -, -, -, -, -, -, h73, h75, h76⟩ := θ₇_spec (hE.mono (by norm_num))
  have hF : ∀ c, c ∈ jointEigen (cliffR 8) ↔
      ∀ θ ∈ [θ₃ (cliffE 8), θ₅ (cliffE 8), θ₆ (cliffE 8), θ₇ (cliffE 8)], c * θ = c := by
    intro c
    simp [jointEigen, eigX, eigW, eigV₁, θ₃_cliffR (by norm_num : 3 ≤ 8),
      θ₅_cliffR (by norm_num : 5 ≤ 8), θ₆_cliffR (by norm_num : 6 ≤ 8),
      θ₇_cliffR (by norm_num : 7 ≤ 8), sub_eq_zero, and_assoc]
  have hFdim : finrank ℝ (jointEigen (cliffR 8)) = milnorM 8 := by
    have := finrank_eq_sixteen_mul (isClifford_cliffR 8)
    rw [finrank_cliffordAlgebra] at this
    change _ = 16
    omega
  have hVpos : 0 < finrank ℝ (jointEigen J) := by
    have h1 := finrank_eq_sixteen_mul h
    have h2 : 0 < finrank ℝ V := Module.finrank_pos
    omega
  obtain ⟨u, hu, hu0⟩ := exists_ne_zero_mem hVpos
  simp only [jointEigen, eigX, eigW, eigV₁, Submodule.mem_inf, mem_ker_sub_one_iff] at hu
  have hfix : ∀ θ ∈ [θ₃ (cliffE 8), θ₅ (cliffE 8), θ₆ (cliffE 8), θ₇ (cliffE 8)],
      cliffordLift h θ u = u := by
    simp only [List.mem_cons, List.not_mem_nil, or_false]
    rintro θ (rfl | rfl | rfl | rfl)
    · rw [cliffordLift_θ₃ h (by norm_num)]; exact hu.1.1.1
    · rw [cliffordLift_θ₅ h (by norm_num)]; exact hu.1.1.2
    · rw [cliffordLift_θ₆ h (by norm_num)]; exact hu.1.2
    · rw [cliffordLift_θ₇ h (by norm_num)]; exact hu.2
  have hcomm : [θ₃ (cliffE 8), θ₅ (cliffE 8), θ₆ (cliffE 8), θ₇ (cliffE 8)].Pairwise Commute := by
    simp only [List.pairwise_cons, List.mem_cons, List.not_mem_nil, or_false,
      forall_eq_or_imp, forall_eq, List.Pairwise.nil, and_true, IsEmpty.forall_iff, implies_true]
    exact ⟨⟨h53.symm, h63.symm, h73.symm⟩, ⟨h65.symm, h75.symm⟩, h76.symm⟩
  obtain ⟨hd, e, he⟩ := minimal_of_fixed h (by norm_num) hmin _
    (by simp [h3sq, h5sq, h6sq, h7sq]) hcomm _ hF hFdim hu0 hfix
  exact ⟨hd, u, e, he⟩


omit [FiniteDimensional ℝ V] in
/-- A central involution acts as `±1` on a minimal space (Milnor p. 143: "`J_3` is equal to
`+J_1J_2` or `−J_1J_2`", "`J_7` is equal to `±J_1J_2J_3J_4J_5J_6`"). -/
theorem central_involution {J : ℕ → Module.End ℝ V} {θ : Module.End ℝ V}
    (hmin : IsMinimalCliffordModule J k) (hθ : θ * θ = 1)
    (hc : ∀ α, 1 ≤ α → α ≤ k → Commute θ (J α)) : (∀ v, θ v = v) ∨ (∀ v, θ v = -v) := by
  have hθv : ∀ v, θ (θ v) = v := fun v => by
    rw [← Module.End.mul_apply, hθ, Module.End.one_apply]
  rcases hmin.2 (LinearMap.ker (θ - 1))
      (fun α h1 h2 w hw => mapsTo_ker_of_commute (hc α h1 h2).eq.symm hw) with hbot | htop
  · right
    intro v
    have hmem : v + θ v ∈ LinearMap.ker (θ - 1) := by
      rw [mem_ker_sub_one_iff, map_add, hθv, add_comm]
    rw [hbot, Submodule.mem_bot] at hmem
    exact eq_neg_of_add_eq_zero_right hmem
  · left
    intro v
    have : v ∈ LinearMap.ker (θ - 1) := htop ▸ Submodule.mem_top
    exact (mem_ker_sub_one_iff _ _).1 this

omit [FiniteDimensional ℝ V] in
/-- A subspace closed under `J_1, …, J_{k−1}` and stable under an involution `θ` acting by `±1`
from which `J_k` is recovered as `J_k = w θ` (`w` a word in `J_1, …, J_{k−1}`) is closed under
`J_k`; so a minimal `(J_1, …, J_k)`-space is a minimal `(J_1, …, J_{k−1})`-space. -/
theorem isMinimal_pred {J : ℕ → Module.End ℝ V} {θ w : Module.End ℝ V}
    (hmin : IsMinimalCliffordModule J (k + 1)) (hθ : (∀ v, θ v = v) ∨ (∀ v, θ v = -v))
    (hJ : J (k + 1) = w * θ)
    (hw : ∀ W : Submodule ℝ V, (∀ α, 1 ≤ α → α ≤ k → ∀ x ∈ W, J α x ∈ W) → ∀ x ∈ W, w x ∈ W) :
    IsMinimalCliffordModule J k := by
  refine ⟨hmin.1, fun W hW => hmin.2 W fun α h1 h2 x hx => ?_⟩
  rcases lt_or_eq_of_le h2 with hlt | rfl
  · exact hW α h1 (by omega) x hx
  · rw [hJ, Module.End.mul_apply]
    rcases hθ with hθ | hθ
    · rw [hθ]; exact hw W hW x hx
    · rw [hθ, map_neg]; exact W.neg_mem (hw W hW x hx)

omit [FiniteDimensional ℝ V] in
/-- `k = 3`: a minimal space is a minimal `(J_1, J_2)`-space, of dimension `4`. -/
theorem minimal_three {J : ℕ → Module.End ℝ V} (h : IsClifford J 3)
    (hmin : IsMinimalCliffordModule J 3) : IsMinimalCliffordModule J 2 := by
  obtain ⟨hsq, hc1, hc2, hc3⟩ := θ₃_spec h
  have hθ := central_involution hmin hsq (fun α h1 h2 => by
    interval_cases α
    · exact hc1
    · exact hc2
    · exact hc3)
  refine isMinimal_pred hmin hθ (w := J 2 * J 1) (by unfold θ₃; clifford_simp h) ?_
  intro W hW x hx
  rw [Module.End.mul_apply]
  exact hW 2 (by norm_num) le_rfl _ (hW 1 le_rfl (by norm_num) x hx)

omit [FiniteDimensional ℝ V] in
/-- `k = 7`: a minimal space is a minimal `(J_1, …, J_6)`-space, of dimension `8`. -/
theorem minimal_seven {J : ℕ → Module.End ℝ V} (h : IsClifford J 7)
    (hmin : IsMinimalCliffordModule J 7) : IsMinimalCliffordModule J 6 := by
  obtain ⟨-, hc⟩ := ω₇_spec h
  have hsq : ω₇ J * ω₇ J = 1 := by unfold ω₇; clifford_simp h
  have hθ := central_involution hmin hsq hc
  refine isMinimal_pred hmin hθ (w := J 6 * J 5 * J 4 * J 3 * J 2 * J 1)
    (by unfold ω₇; clifford_simp h) ?_
  intro W hW x hx
  simp only [Module.End.mul_apply]
  refine hW 6 (by norm_num) le_rfl _ (hW 5 (by norm_num) (by norm_num) _ (hW 4 (by norm_num)
    (by norm_num) _ (hW 3 (by norm_num) (by norm_num) _ (hW 2 (by norm_num) (by norm_num) _
    (hW 1 le_rfl (by norm_num) x hx)))))

/-- **Lemma 24.8, dimensions** (p. 143): for `k ≤ 8` every minimal `(J_1, …, J_k)`-space has
dimension exactly `m_k`. -/
theorem finrank_eq_milnorM_of_isMinimal {J : ℕ → Module.End ℝ V} (hk : k ≤ 8)
    (h : IsClifford J k) (hmin : IsMinimalCliffordModule J k) : finrank ℝ V = milnorM k := by
  interval_cases k
  · exact (minimal_le_two h (by norm_num) hmin).1
  · exact (minimal_le_two h (by norm_num) hmin).1
  · exact (minimal_le_two h (by norm_num) hmin).1
  · exact (minimal_le_two (h.mono (by norm_num)) le_rfl (minimal_three h hmin)).1
  · exact (minimal_four h hmin).1
  · exact (minimal_five h hmin).1
  · exact (minimal_six h hmin).1
  · exact (minimal_six (h.mono (by norm_num)) (minimal_seven h hmin)).1
  · exact (minimal_eight h hmin).1


omit [FiniteDimensional ℝ V] in
/-- Two minimal spaces which are both isomorphic to the same left ideal `F ⊆ C_k` by orbit maps
are isomorphic, by an isomorphism commuting with the `J_α`. -/
theorem exists_iso_of_equiv {V' : Type*} [AddCommGroup V'] [Module ℝ V']
    {J : ℕ → Module.End ℝ V} {J' : ℕ → Module.End ℝ V'} (h : IsClifford J k)
    (h' : IsClifford J' k) (F : Submodule ℝ (CliffordAlgebra (cliffQ k)))
    (hFmul : ∀ a, ∀ c ∈ F, a * c ∈ F) {u : V} {u' : V'} (e : F ≃ₗ[ℝ] V)
    (he : ∀ c, e c = cliffordLift h c u) (e' : F ≃ₗ[ℝ] V')
    (he' : ∀ c, e' c = cliffordLift h' c u') :
    ∃ T : V ≃ₗ[ℝ] V', ∀ α, 1 ≤ α → α ≤ k → ∀ v, T (J α v) = J' α (T v) := by
  refine ⟨e.symm.trans e', fun α h1 h2 v => ?_⟩
  set c := e.symm v with hc
  have hv : v = cliffordLift h c u := by rw [← he, hc, LinearEquiv.apply_symm_apply]
  have hJv : J α v = e ⟨cliffE k α * c, hFmul _ _ c.2⟩ := by
    rw [he, hv, ← cyclicMap_apply, ← cyclicMap_apply, cyclicMap_mul h u h1 h2]
  rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, hJv, LinearEquiv.symm_apply_apply, he',
    he', ← cyclicMap_apply, ← cyclicMap_apply, cyclicMap_mul h' u' h1 h2]

/-- **Lemma 24.8** (Bott–Shapiro, p. 143), for `k ≤ 8`: if `k ≢ 3 (mod 4)`, any two minimal
`(J_1, …, J_k)`-spaces are isomorphic, by a linear isomorphism commuting with the `J_α`. -/
theorem exists_iso_of_isMinimal {V' : Type*} [AddCommGroup V'] [Module ℝ V']
    [FiniteDimensional ℝ V'] {J : ℕ → Module.End ℝ V} {J' : ℕ → Module.End ℝ V'} (hk : k ≤ 8)
    (hk3 : k % 4 ≠ 3) (h : IsClifford J k) (h' : IsClifford J' k)
    (hmin : IsMinimalCliffordModule J k) (hmin' : IsMinimalCliffordModule J' k) :
    ∃ T : V ≃ₗ[ℝ] V', ∀ α, 1 ≤ α → α ≤ k → ∀ v, T (J α v) = J' α (T v) := by
  interval_cases k
  · obtain ⟨-, u, e, he⟩ := minimal_le_two h (by norm_num) hmin
    obtain ⟨-, u', e', he'⟩ := minimal_le_two h' (by norm_num) hmin'
    exact exists_iso_of_equiv h h' ⊤ (fun _ _ _ => Submodule.mem_top) e he e' he'
  · obtain ⟨-, u, e, he⟩ := minimal_le_two h (by norm_num) hmin
    obtain ⟨-, u', e', he'⟩ := minimal_le_two h' (by norm_num) hmin'
    exact exists_iso_of_equiv h h' ⊤ (fun _ _ _ => Submodule.mem_top) e he e' he'
  · obtain ⟨-, u, e, he⟩ := minimal_le_two h (by norm_num) hmin
    obtain ⟨-, u', e', he'⟩ := minimal_le_two h' (by norm_num) hmin'
    exact exists_iso_of_equiv h h' ⊤ (fun _ _ _ => Submodule.mem_top) e he e' he'
  · exact absurd rfl hk3
  · obtain ⟨-, u, e, he⟩ := minimal_four h hmin
    obtain ⟨-, u', e', he'⟩ := minimal_four h' hmin'
    refine exists_iso_of_equiv h h' _ (fun a c hc => ?_) e he e' he'
    simp only [eigV₁] at hc ⊢
    rw [θ₃_cliffR (by norm_num)] at hc ⊢
    exact ker_mulRight_mul a hc
  · obtain ⟨-, u, e, he⟩ := minimal_five h hmin
    obtain ⟨-, u', e', he'⟩ := minimal_five h' hmin'
    refine exists_iso_of_equiv h h' _ (fun a c hc => ?_) e he e' he'
    simp only [eigW, eigV₁, Submodule.mem_inf] at hc ⊢
    rw [θ₃_cliffR (by norm_num), θ₅_cliffR (by norm_num)] at hc ⊢
    exact ⟨ker_mulRight_mul a hc.1, ker_mulRight_mul a hc.2⟩
  · obtain ⟨-, u, e, he⟩ := minimal_six h hmin
    obtain ⟨-, u', e', he'⟩ := minimal_six h' hmin'
    refine exists_iso_of_equiv h h' _ (fun a c hc => ?_) e he e' he'
    simp only [eigX, eigW, eigV₁, Submodule.mem_inf] at hc ⊢
    rw [θ₃_cliffR (by norm_num), θ₅_cliffR (by norm_num), θ₆_cliffR (by norm_num)] at hc ⊢
    exact ⟨⟨ker_mulRight_mul a hc.1.1, ker_mulRight_mul a hc.1.2⟩, ker_mulRight_mul a hc.2⟩
  · exact absurd rfl hk3
  · obtain ⟨-, u, e, he⟩ := minimal_eight h hmin
    obtain ⟨-, u', e', he'⟩ := minimal_eight h' hmin'
    refine exists_iso_of_equiv h h' _ (fun a c hc => ?_) e he e' he'
    simp only [jointEigen, eigX, eigW, eigV₁, Submodule.mem_inf] at hc ⊢
    rw [θ₃_cliffR (by norm_num), θ₅_cliffR (by norm_num), θ₆_cliffR (by norm_num),
      θ₇_cliffR (by norm_num)] at hc ⊢
    exact ⟨⟨⟨ker_mulRight_mul a hc.1.1.1, ker_mulRight_mul a hc.1.1.2⟩,
      ker_mulRight_mul a hc.1.2⟩, ker_mulRight_mul a hc.2⟩

end Minimal

