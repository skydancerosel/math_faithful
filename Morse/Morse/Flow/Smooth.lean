import Morse.Flow.Global
import Morse.Flow.Volterra

/-!
Milnor, *Morse Theory*, §2, pp. 10–11.

# Smooth dependence on the initial point, and Lemma 2.4

Milnor, p. 10:

> **Lemma 2.4.** A smooth vector field on `M` which vanishes outside of a compact set `K ⊂ M`
> generates a unique 1-parameter group of diffeomorphisms of `M`.

His proof rests on the statement that the differential equation `dφ_t(q)/dt = X_{φ_t(q)}`,
`φ_0(q) = q`, "locally, has a unique solution which depends smoothly on the initial conditions"
(p. 10, citing Graves), and ends (p. 11) with "It is not difficult to verify that `φ_t` is well
defined, smooth, and satisfies the condition `φ_{t+s} = φ_t ∘ φ_s`." The global flow, the group
law and the continuity are `Morse/Flow/Global.lean`. This file proves the smoothness and
assembles Lemma 2.4 for `M = E` a finite-dimensional real normed space (`ℝᴷ` in the
applications). The proofs only use that `E` is complete, assumed as `[CompleteSpace E]`; Mathlib
infers this instance from `[FiniteDimensional ℝ E]`.

## Smooth dependence on the initial point: the proof

Milnor's "well known" fact is the one place where real work is hidden. We prove it as follows.

1. **The time-one map of a field with Lipschitz constant `c < 1` is as smooth as the field.**
   On `[0, 1]` the flow line through `x` is the unique solution of `Ψ(γ) = x` with
   `Ψ(γ) = γ − P(X ∘ γ)`, `(P γ)(s) = ∫₀ˢ γ` (`IsBddLipschitz.volt_flowCurve`). By
   `Morse/Flow/Volterra.lean`, `Ψ` is a homeomorphism of `C([0, 1], E)` whose inverse is as smooth
   as `X` (inverse function theorem in the Banach space `C([0, 1], E)`, the Nemytskii operator
   `γ ↦ X ∘ γ` being as smooth as `X` by `Morse/Flow/Nemytskii.lean`). So
   `x ↦ φ_1(x) = Ψ⁻¹(x)(1)` is a composite of smooth maps (`contDiff_flow_one_of_lipschitz`).
2. **All times.** For `t ∈ ℝ` choose `N > |t| K` (`K` a Lipschitz constant of `X`); then
   `Y = (t/N) X` has Lipschitz constant `< 1`, its time-one map is `φ_{t/N}` (rescaling time), and
   `φ_t = (φ_{t/N})^N` (`contDiff_flow`).
3. **Joint smoothness in `(t, x)`.** On `E × ℝ` consider `Z(x, τ) = (ρ(τ) X(x), 0)`, where
   `ρ(τ) = τ` for `|τ| ≤ R` and `ρ` has compact support. Its flow is
   `φ^Z_s(x, τ) = (φ_{s ρ(τ)}(x), τ)`, so `(t, x) ↦ φ_t(x)` agrees on `{|t| < R}` with the first
   component of the smooth map `(x, t) ↦ φ^Z_1(x, t)` (`contDiff_flow_uncurry`). This trades the
   time variable for a space variable and is why step 1 is only needed for fixed time.

The argument gives `Cⁿ` dependence for a `Cⁿ` field (`1 ≤ n ≤ ∞`), not only `C^∞`.

## What Milnor's text leaves implicit

* The smooth dependence on initial conditions (above): a theorem, not a remark.
* "It is not difficult to verify that `φ_t` is ... smooth": the smoothness of `(t, q) ↦ φ_t(q)`
  for large `t` needs the joint smoothness of the local flow; Milnor's iteration
  `φ_t = φ_{ε₀/2} ∘ ⋯ ∘ φ_{ε₀/2} ∘ φ_r` with `r` depending on `t` gives it only after checking
  that the decomposition of `t` can be chosen locally constant in `t`. Step 3 avoids the issue.
* That each `φ_t` is a diffeomorphism: `φ_{-t}` is a smooth inverse by the group law.
* The definition of a 1-parameter group asks for each `φ_t` to be a diffeomorphism; with the
  group law it would suffice that `φ_0` be injective, since then `φ_0 = id`
  (`IsOneParameterGroup.zero`), as used in the uniqueness part.
* Uniqueness ("generates a *unique* 1-parameter group") is only implicit in the text. Milnor's
  computation on p. 10 shows that the orbit `t ↦ φ_t(q)` of any 1-parameter group generated by
  `X` is an integral curve of `X` through `q` (this uses `φ_0 = id`,
  `IsOneParameterGroup.isIntegralCurve`); two integral curves through `q` defined on all of `ℝ`
  agree, by uniqueness of solutions, which is *global* in time (`lemma_2_4`).

## Main results

* `Morse.contDiff_flow`: for `X` of class `Cⁿ` (`n ≥ 1`) with compact support, each `φ_t` is
  `Cⁿ`.
* `Morse.contDiff_flow_uncurry`: `(t, x) ↦ φ_t(x)` is `Cⁿ` on `ℝ × E`.
* `Morse.flowDiffeomorph`: each `φ_t` as a `Cⁿ` diffeomorphism
  (`Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E n`).
* `Morse.lemma_2_4`: **Milnor's Lemma 2.4** for `M = E`: a `C^∞` vector field with compact
  support generates a unique 1-parameter group of diffeomorphisms.
-/

open Set Filter Topology Metric Function Morse.Flow
open scoped ContDiff NNReal Manifold

noncomputable section

namespace Morse

universe u

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] {X : E → E}

/-! ### The flow line as a solution of the integral equation -/

/-- The flow line through `x`, restricted to `[0, 1]`, as a point of `C([0, 1], E)`. -/
def IsBddLipschitz.flowCurve (hX : IsBddLipschitz X) (x : E) : C(unitInterval, E) :=
  ⟨fun s => flow X s x, (hX.continuous_flow_left x).comp continuous_subtype_val⟩

theorem IsBddLipschitz.flowCurve_apply (hX : IsBddLipschitz X) (x : E) (s : unitInterval) :
    hX.flowCurve x s = flow X s x :=
  rfl

/-- The flow line through `x` solves the integral equation
`γ(s) - ∫₀ˢ X(γ(r)) dr = x` (fundamental theorem of calculus). -/
theorem IsBddLipschitz.volt_flowCurve (hX : IsBddLipschitz X) (hXc : Continuous X) (x : E) :
    volt ⟨X, hXc⟩ (hX.flowCurve x) = ContinuousMap.const unitInterval x := by
  ext s
  rw [volt_apply, ContinuousMap.sub_apply, prim_apply, ContinuousMap.const_apply,
    hX.flowCurve_apply]
  have h1 : ∫ r in (0 : ℝ)..(s : ℝ), nem ⟨X, hXc⟩ (hX.flowCurve x) (projIcc 0 1 zero_le_one r) =
      ∫ r in (0 : ℝ)..(s : ℝ), X (flow X r x) := by
    refine intervalIntegral.integral_congr fun r hr => ?_
    rw [uIcc_of_le s.2.1] at hr
    have hr' : r ∈ Icc (0 : ℝ) 1 := ⟨hr.1, hr.2.trans s.2.2⟩
    simp only [nem_apply, ContinuousMap.coe_mk, hX.flowCurve_apply, projIcc_of_mem _ hr']
  have h2 : ∫ r in (0 : ℝ)..(s : ℝ), X (flow X r x) = flow X s x - flow X 0 x :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt (fun r _ => hX.hasDerivAt_flow r x)
      ((hXc.comp (hX.continuous_flow_left x)).intervalIntegrable _ _)
  rw [h1, h2, hX.flow_zero]
  abel

/-- The constant curves, as a continuous linear map `E → C([0, 1], E)`. -/
def constCLM : E →L[ℝ] C(unitInterval, E) :=
  @LinearMap.mkContinuous ℝ ℝ E C(unitInterval, E) _ _ _ _ _ _ (RingHom.id ℝ)
    { toFun := fun x => ContinuousMap.const unitInterval x
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
    1 fun x => by
      rw [one_mul]
      exact (ContinuousMap.norm_le _ (norm_nonneg x)).2 fun _ => le_rfl

omit [CompleteSpace E] in
theorem constCLM_apply (x : E) : constCLM x = ContinuousMap.const unitInterval x :=
  rfl

/-! ### Smoothness of the time-`t` maps -/

/-- **Step 1.** If `X` is `Cⁿ` (`n ≥ 1`), bounded, and Lipschitz with constant `c < 1`, then the
time-one map `φ_1` is `Cⁿ`: it is `x ↦ Ψ⁻¹(x)(1)`. -/
theorem contDiff_flow_one_of_lipschitz {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n)
    (hb : IsBddLipschitz X) {c : ℝ≥0} (hc : c < 1) (hL : LipschitzWith c X) :
    ContDiff ℝ n (flow X 1) := by
  let Φ := (voltHomeomorph (Y := ⟨X, hX.continuous⟩) hL hc).symm
  have h : flow X 1 = fun x => ContinuousMap.evalCLM ℝ (1 : unitInterval) (Φ (constCLM x)) := by
    ext x
    have hx : hb.flowCurve x = Φ (constCLM x) := by
      rw [Homeomorph.eq_symm_apply, coe_voltHomeomorph, constCLM_apply]
      exact hb.volt_flowCurve hX.continuous x
    rw [← hx]
    rfl
  rw [h]
  have hev : ContDiff ℝ n
      (ContinuousMap.evalCLM ℝ (1 : unitInterval) : C(unitInterval, E) → E) := by
    exact ContinuousLinearMap.contDiff _
  have hconst : ContDiff ℝ n (constCLM : E → C(unitInterval, E)) := by
    exact ContinuousLinearMap.contDiff _
  exact hev.comp ((contDiff_voltHomeomorph_symm hX hn hc hL).comp hconst)

omit [CompleteSpace E] in
theorem contDiff_iterate {n : ℕ∞} {f : E → E} (hf : ContDiff ℝ n f) (k : ℕ) :
    ContDiff ℝ n f^[k] := by
  induction k with
  | zero => exact contDiff_id
  | succ k ih => rw [Function.iterate_succ']; exact hf.comp ih

/-- **Smooth dependence on the initial point.** If `X` is `Cⁿ` (`1 ≤ n ≤ ∞`) and vanishes outside
a compact set, then each time-`t` map `φ_t` is `Cⁿ`. -/
theorem contDiff_flow {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n) (hs : HasCompactSupport X)
    (t : ℝ) : ContDiff ℝ n (flow X t) := by
  have hX1 : ContDiff ℝ 1 X := hX.of_le (by exact_mod_cast hn)
  have hb := IsBddLipschitz.of_contDiff hX1 hs
  obtain ⟨K, hK⟩ := hb.lipschitz
  obtain ⟨N, hN⟩ := exists_nat_gt (|t| * K)
  have hN0 : (0 : ℝ) < N := lt_of_le_of_lt (by positivity) hN
  set τ := t / N with hτ
  have hY : ContDiff ℝ n (τ • X) := hX.const_smul τ
  have hLY : LipschitzWith (‖τ‖₊ * K) (τ • X) := (lipschitzWith_smul τ).comp hK
  have hcY : ‖τ‖₊ * K < 1 := by
    rw [← NNReal.coe_lt_coe, NNReal.coe_mul, coe_nnnorm, Real.norm_eq_abs, hτ, abs_div,
      Nat.abs_cast, NNReal.coe_one, div_mul_eq_mul_div, div_lt_one hN0]
    exact hN
  have h1 : ContDiff ℝ n (flow (τ • X) 1) :=
    contDiff_flow_one_of_lipschitz hY hn (hb.smul τ) hcY hLY
  have h1' : flow (τ • X) 1 = flow X τ := funext fun x => by rw [hb.flow_smul, mul_one]
  have h2 : flow X t = (flow X τ)^[N] := by
    rw [← hb.flow_nat_mul, hτ, mul_div_cancel₀ t hN0.ne']
  rw [h2, ← h1']
  exact contDiff_iterate h1 N

/-! ### Joint smoothness in `(t, x)` -/

/-- **Joint smooth dependence.** If `X` is `Cⁿ` (`1 ≤ n ≤ ∞`) and vanishes outside a compact
set, then `(t, x) ↦ φ_t(x)` is `Cⁿ` on `ℝ × E`. -/
theorem contDiff_flow_uncurry {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n)
    (hs : HasCompactSupport X) : ContDiff ℝ n (fun p : ℝ × E => flow X p.1 p.2) := by
  have hX1 : ContDiff ℝ 1 X := hX.of_le (by exact_mod_cast hn)
  have hb := IsBddLipschitz.of_contDiff hX1 hs
  rw [contDiff_iff_contDiffAt]
  intro p
  -- a cut-off `ρ(τ) = τ` for `|τ| ≤ R`
  set R : ℝ := |p.1| + 1 with hR
  have hR0 : 0 < R := by positivity
  let χ : ContDiffBump (0 : ℝ) := ⟨R, R + 1, hR0, by linarith⟩
  let ρ : ℝ → ℝ := fun τ => χ τ * τ
  have hρ : ContDiff ℝ ∞ ρ := χ.contDiff.mul contDiff_id
  have hρs : HasCompactSupport ρ := χ.hasCompactSupport.mul_right
  have hρR : ∀ τ : ℝ, |τ| ≤ R → ρ τ = τ := fun τ hτ => by
    have : χ τ = 1 := χ.one_of_mem_closedBall (by rwa [mem_closedBall, Real.dist_eq, sub_zero])
    simp only [ρ, this, one_mul]
  -- the auxiliary field `Z(x, τ) = (ρ(τ) X(x), 0)` on `E × ℝ`
  let Z : E × ℝ → E × ℝ := fun q => (ρ q.2 • X q.1, 0)
  have hZ : ContDiff ℝ n Z :=
    (((hρ.of_le (by exact_mod_cast le_top)).comp contDiff_snd).smul
      (hX.comp contDiff_fst)).prodMk contDiff_const
  have hZs : HasCompactSupport Z := by
    refine HasCompactSupport.intro (hs.isCompact.prod hρs.isCompact) fun q hq => ?_
    simp only [mem_prod, not_and_or] at hq
    rcases hq with hq | hq
    · simp [Z, image_eq_zero_of_notMem_tsupport hq]
    · simp [Z, image_eq_zero_of_notMem_tsupport hq]
  have hZb : IsBddLipschitz Z := IsBddLipschitz.of_contDiff (hZ.of_le (by exact_mod_cast hn)) hZs
  -- the flow of `Z` runs the flow of `X` for the time `s ρ(τ)`
  have hflowZ : ∀ x τ, flow Z 1 (x, τ) = (flow X (ρ τ) x, τ) := by
    intro x τ
    have hγ : IsIntegralCurve (fun s => (flow X (ρ τ * s) x, τ)) (fun _ => Z) := fun s => by
      have h1 := (hb.hasDerivAt_flow (ρ τ * s) x).scomp s ((hasDerivAt_id s).const_mul (ρ τ))
      have := h1.prodMk (hasDerivAt_const s τ)
      simpa [Z, Function.comp_def] using this
    have := hZb.eq_flow hγ 0 1
    simpa [hb.flow_zero] using this.symm
  have hev : (fun q : ℝ × E => (flow Z 1 (q.2, q.1)).1) =ᶠ[𝓝 p]
      (fun q : ℝ × E => flow X q.1 q.2) := by
    have hopen : {q : ℝ × E | |q.1| < R} ∈ 𝓝 p :=
      (isOpen_lt (continuous_abs.comp continuous_fst) continuous_const).mem_nhds
        (by simp [hR])
    filter_upwards [hopen] with q hq
    rw [hflowZ, hρR q.1 hq.le]
  have hZ1 : ContDiff ℝ n (flow Z 1) := contDiff_flow hZ hn hZs 1
  exact (contDiff_fst.comp (hZ1.comp (contDiff_snd.prodMk contDiff_fst))).contDiffAt
    |>.congr_of_eventuallyEq hev.symm

/-! ### Diffeomorphisms -/

/-- Each `φ_t` is a `Cⁿ` diffeomorphism of `E` (with inverse `φ_{-t}`), for `X` of class `Cⁿ`
(`1 ≤ n ≤ ∞`) with compact support. -/
def flowDiffeomorph {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n) (hs : HasCompactSupport X)
    (t : ℝ) : Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E n where
  toEquiv := ((IsBddLipschitz.of_contDiff (hX.of_le (by exact_mod_cast hn)) hs).flowHomeomorph
    t).toEquiv
  contMDiff_toFun := (contDiff_flow hX hn hs t).contMDiff
  contMDiff_invFun := (contDiff_flow hX hn hs (-t)).contMDiff

@[simp]
theorem coe_flowDiffeomorph {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n)
    (hs : HasCompactSupport X) (t : ℝ) : ⇑(flowDiffeomorph hX hn hs t) = flow X t :=
  rfl

@[simp]
theorem coe_flowDiffeomorph_symm {n : ℕ∞} (hX : ContDiff ℝ n X) (hn : 1 ≤ n)
    (hs : HasCompactSupport X) (t : ℝ) : ⇑(flowDiffeomorph hX hn hs t).symm = flow X (-t) :=
  rfl

/-! ### Lemma 2.4 -/

/-- Milnor's definition (pp. 9–10): a **1-parameter group of diffeomorphisms** of `E` is a `C^∞`
map `φ : ℝ × E → E` such that each `φ_t` is a diffeomorphism of `E` onto itself and
`φ_{t+s} = φ_t ∘ φ_s`. -/
structure IsOneParameterGroup (φ : ℝ → E → E) : Prop where
  contDiff : ContDiff ℝ ∞ (fun p : ℝ × E => φ p.1 p.2)
  diffeo : ∀ t, ∃ e : Diffeomorph 𝓘(ℝ, E) 𝓘(ℝ, E) E E ∞, ⇑e = φ t
  add : ∀ s t, φ (s + t) = φ s ∘ φ t

/-- Milnor's definition (p. 10): the vector field `X` **generates** `φ` if
`X_q = lim_{h → 0} (φ_h(q) − q)/h` for every `q` (in `E`, a tangent vector is a vector and
Milnor's `X_q(f)` is the derivative of `f` along it). -/
def Generates (X : E → E) (φ : ℝ → E → E) : Prop :=
  ∀ x, HasDerivAt (fun h => φ h x) (X x) 0

omit [CompleteSpace E] in
/-- `φ_0 = id` for a 1-parameter group (Milnor leaves this implicit). -/
theorem IsOneParameterGroup.zero {φ : ℝ → E → E} (hφ : IsOneParameterGroup φ) (x : E) :
    φ 0 x = x := by
  obtain ⟨e, he⟩ := hφ.diffeo 0
  have h : φ 0 (φ 0 x) = φ 0 x := by
    have := congrFun (hφ.add 0 0) x
    rw [add_zero] at this
    exact this.symm
  rw [← he] at h ⊢
  exact e.injective h

omit [CompleteSpace E] in
/-- The orbits of a 1-parameter group generated by `X` are integral curves of `X` (Milnor p. 10:
"Then for each fixed `q` the curve `t → φ_t(q)` satisfies the differential equation
`dφ_t(q)/dt = X_{φ_t(q)}`"). -/
theorem IsOneParameterGroup.isIntegralCurve {φ : ℝ → E → E} (hφ : IsOneParameterGroup φ)
    (hX : Generates X φ) (x : E) : IsIntegralCurve (fun t => φ t x) (fun _ => X) := fun t => by
  have h1 : (fun s => φ s x) = fun s => φ (s - t) (φ t x) := funext fun s => by
    rw [← Function.comp_apply (f := φ (s - t)), ← hφ.add, sub_add_cancel]
  have h2 := hX (φ t x)
  rw [← sub_self t] at h2
  have h3 : HasDerivAt (fun s => φ (s - t) (φ t x)) (X (φ t x)) t := h2.comp_sub_const t t
  rw [← h1] at h3
  exact h3

/-- **Milnor's Lemma 2.4** (p. 10), for `M = E` a finite-dimensional real normed space: a
smooth vector field on `E` which vanishes outside of a compact set generates a unique 1-parameter
group of diffeomorphisms of `E`, namely its flow. (Only the completeness of `E` is used; in an
infinite-dimensional space the only continuous field with compact support is `0`.) -/
theorem lemma_2_4 (hX : ContDiff ℝ ∞ X) (hs : HasCompactSupport X) :
    ∃! φ : ℝ → E → E, IsOneParameterGroup φ ∧ Generates X φ := by
  have hb := IsBddLipschitz.of_contDiff (hX.of_le (by exact_mod_cast le_top)) hs
  have h1 : (1 : ℕ∞) ≤ ⊤ := le_top
  refine ⟨flow X, ⟨⟨contDiff_flow_uncurry hX h1 hs, fun t => ⟨flowDiffeomorph hX h1 hs t, rfl⟩,
    hb.flow_comp⟩, fun x => ?_⟩, ?_⟩
  · have := hb.hasDerivAt_flow 0 x
    rwa [hb.flow_zero] at this
  · rintro ψ ⟨hψ, hψX⟩
    funext t x
    have := hb.eq_flow (hψ.isIntegralCurve hψX x) 0 t
    rwa [sub_zero, hψ.zero] at this

end Morse
