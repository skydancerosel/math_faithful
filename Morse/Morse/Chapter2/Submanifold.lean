import Morse.Chapter2.Regular
import Morse.Chapter1.ManifoldSubmanifold
import Milnor.Chapter2.Corestrict

/-!
Milnor, *Morse Theory*, §3, pp. 12–13, for a submanifold of Euclidean space.

# Theorem 3.1 for a function on a submanifold `N ⊆ ℝᴷ`

Milnor's Theorem 3.1 is stated for a smooth function `f` on a manifold `M` and proved with the flow
of `X = ρ · grad f` for a Riemannian metric on `M`, generated by Lemma 2.4. Lemma 2.4 is formalized
(`Morse/Flow/`) for compactly supported fields on a vector space only. This file proves Theorem 3.1
for `M = N ⊆ V` (`V` a finite-dimensional real normed space, Milnor's `ℝᴷ`) a submanifold given by
slice charts (`Milnor.IsSliceSubmanifold`, the companion project's notion, with its manifold
structure `hN.chartedSpace`) and `f = F|N` the restriction of a smooth `F : V → ℝ`, by running
Milnor's argument with an *ambient* flow which preserves `N`.

## The argument

Let `K = N ∩ F⁻¹[a, b]`, compact, without critical points of `F|N`.

1. **A tangent field along which `F` increases** (`exists_tangent_field`). At `q ∈ K` choose a
   slice chart `φ : U → Z × W` (`N ∩ U = φ⁻¹(Z × 0)`) and `u ∈ Z` such that the coordinate field
   `x ↦ (dφ_x)⁻¹(u, 0)` (`chartField`) has `dF > 0` at `q`; it is tangent to `N` along `N ∩ U`
   (`chartField_mem_tangentSubspace`). Bump functions and a finite subcover of `K` patch these into
   a smooth field `Y` on `V`, tangent to `N` along `N`, with `dF(Y) > 0` on `K`.
2. **Normalization.** With `ρ` smooth, compactly supported, `ρ · dF(Y) = 1` on `K`
   (`exists_cutoff_mul`), the field `X = ρ Y` is smooth with compact support, tangent to `N` along
   `N`, and `dF(X) = 1` on `K`. This plays the role of Milnor's `ρ · grad f` (for the metric
   induced by an inner product on `V`, `grad f` is the orthogonal projection of `∇F` on `T_qN`);
   the proof only uses `df(X) = 1` on `K`, so no metric is needed.
3. **Invariance** (`flow_mem_of_tangent`). Through each point of `N` there is a local integral
   curve of `X` inside `N`: in a slice chart, solve the ODE for the first component in `Z`
   (Picard–Lindelöf, Mathlib's
   `ContDiffAt.exists_forall_mem_closedBall_exists_eq_forall_mem_Ioo_hasDerivAt₀`) and map it
   back by the parametrization `z ↦ φ⁻¹(z, 0)` (`exists_integralCurve_mem`). `N` need
   not be closed in `V`; it is closed in the open union `O` of the chart domains
   (`chartDomain`), `X` vanishes off `O`, and `N ∪ (V \ O)` is a closed set to which
   `Morse.IsBddLipschitz.flow_mem` applies; a trajectory cannot jump to a zero of `X`.
4. **Theorem 3.1.** The ambient flow restricted to `N` is a slab flow for `F|N`
   (`Morse.IsSlabFlow`), and `Morse/Chapter2/Crossing.lean` gives the rest. The time-`(b - a)` map
   restricted to `N` is a diffeomorphism of the manifold `N` (Milnor's corestriction lemma
   `Milnor.IsSliceSubmanifold.contMDiff_codRestrict`).

## Main results

* `Morse.chartField`, `Morse.chartField_mem_tangentSubspace`, `Morse.exists_chartField_pos`.
* `Morse.exists_tangent_field`: the field `Y` of step 1.
* `Morse.exists_integralCurve_mem`, `Morse.flow_mem_of_tangent`: invariance of `N`.
* `Morse.theorem_3_1_submanifold`: **Theorem 3.1** for `f = F|N`: if `N ∩ F⁻¹[a, b]` is compact
  and contains no critical point of `F|N`, there is a diffeomorphism of `N` carrying `N^a` onto
  `N^b`, `N^a` is a strong deformation retract of `N^b`, and the inclusion `N^a → N^b` is a
  homotopy equivalence. `Morse.theorem_3_1_submanifold_of_isCompact`: the case of compact `N`.

## Differences from Milnor's setting

* `f` is assumed to be the restriction of a smooth function on the ambient space. (For a compact
  non-empty submanifold of `ℝᴷ⁺¹` every smooth function on `N` is such a restriction,
  `Morse.exists_contDiff_comp_val_eq`, which carries the theorem to abstract compact manifolds,
  `Morse.theorem_3_1_of_compactSpace`; for a closed non-compact submanifold this is not
  formalized.)
* Critical points of `f` are those of Mathlib's manifold derivative on `N`
  (`Morse.IsCriticalPointM`), equivalently the points where `dF` vanishes on `T_qN`
  (`Morse.isCriticalPointM_comp_val_iff_forall_tangent`).
* The flow of `N` is the restriction of an ambient flow; that `N` is invariant is not an issue in
  Milnor's intrinsic proof, and is step 3 here.
-/

open Set Filter Topology Function
open scoped ContDiff Manifold

noncomputable section

namespace Morse

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  {Z : Type*} [NormedAddCommGroup Z] [NormedSpace ℝ Z]
  {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W]
  {N : Set V}

/-! ### Derivatives of slice charts -/

section SliceChart

variable (σ : Milnor.SliceChart 𝓘(ℝ, V) Z W N)

theorem contDiffOn_sliceChart : ContDiffOn ℝ ∞ σ.φ σ.φ.source :=
  contMDiffOn_iff_contDiffOn.1 σ.φ.contMDiffOn

theorem contDiffOn_sliceChart_invFun : ContDiffOn ℝ ∞ σ.φ.invFun σ.φ.target :=
  contMDiffOn_iff_contDiffOn.1 σ.φ.contMDiffOn_invFun

theorem differentiableAt_sliceChart {x : V} (hx : x ∈ σ.φ.source) :
    DifferentiableAt ℝ σ.φ x :=
  ((contDiffOn_sliceChart σ).contDiffAt (σ.φ.open_source.mem_nhds hx)).differentiableAt
    (by simp)

theorem differentiableAt_sliceChart_invFun {y : Z × W} (hy : y ∈ σ.φ.target) :
    DifferentiableAt ℝ σ.φ.invFun y :=
  ((contDiffOn_sliceChart_invFun σ).contDiffAt (σ.φ.open_target.mem_nhds hy)).differentiableAt
    (by simp)

/-- `dφ_x ∘ (dφ⁻¹)_{φ x} = id`. -/
theorem fderiv_sliceChart_fderiv_invFun {x : V} (hx : x ∈ σ.φ.source) (w : Z × W) :
    fderiv ℝ σ.φ x (fderiv ℝ σ.φ.invFun (σ.φ x) w) = w := by
  have hb : σ.φ x ∈ σ.φ.target := σ.φ.apply_mem hx
  have hψa : σ.φ.invFun (σ.φ x) = x := σ.φ.invFun_apply hx
  have hφd' : DifferentiableAt ℝ σ.φ (σ.φ.invFun (σ.φ x)) := by
    rw [hψa]; exact differentiableAt_sliceChart σ hx
  have h2 : fderiv ℝ (σ.φ ∘ σ.φ.invFun) (σ.φ x) = fderiv ℝ id (σ.φ x) := by
    apply Filter.EventuallyEq.fderiv_eq
    filter_upwards [σ.φ.open_target.mem_nhds hb] with y hy
    exact σ.φ.apply_invFun hy
  rw [fderiv_comp (σ.φ x) hφd' (differentiableAt_sliceChart_invFun σ hb), fderiv_id, hψa] at h2
  exact DFunLike.congr_fun h2 w

/-- The derivative of the parametrization `z ↦ φ⁻¹(z, 0)`. -/
theorem fderiv_sliceParam_apply {z : Z} (hz : z ∈ σ.toChart.target) (w : Z) :
    fderiv ℝ (sliceParam σ) z w = fderiv ℝ σ.φ.invFun (z, 0) (w, 0) := by
  have hz' : (z, (0 : W)) ∈ σ.φ.target := hz
  have hi : HasFDerivAt (fun z : Z => (z, (0 : W))) (ContinuousLinearMap.inl ℝ Z W) z :=
    (hasFDerivAt_id z).prodMk (hasFDerivAt_const 0 z)
  have h := (differentiableAt_sliceChart_invFun σ hz').hasFDerivAt.comp z hi
  rw [show sliceParam σ = σ.φ.invFun ∘ fun z : Z => (z, (0 : W)) from rfl, h.fderiv]
  rfl

end SliceChart

/-! ### Coordinate fields of slice charts -/

section ChartField

variable (σ : Milnor.SliceChart 𝓘(ℝ, V) Z W N)

/-- The coordinate vector field of the slice chart `σ` in the direction `u ∈ Z`:
`x ↦ (dφ_x)⁻¹(u, 0)`, on the domain of the chart. -/
def chartField (u : Z) (x : V) : V :=
  fderiv ℝ σ.φ.invFun (σ.φ x) (u, 0)

theorem contDiffOn_chartField (u : Z) : ContDiffOn ℝ ∞ (chartField σ u) σ.φ.source := by
  have h1 : ContDiffOn ℝ ∞ (fderiv ℝ σ.φ.invFun) σ.φ.target :=
    (contDiffOn_sliceChart_invFun σ).fderiv_of_isOpen σ.φ.open_target (by simp)
  exact (h1.comp (contDiffOn_sliceChart σ) fun x hx => σ.φ.apply_mem hx).clm_apply
    contDiffOn_const

theorem chartField_neg (u : Z) (x : V) : chartField σ (-u) x = -chartField σ u x := by
  rw [chartField, chartField, ← map_neg, Prod.neg_mk, neg_zero]

/-- On `N`, the coordinate field is the derivative of the parametrization. -/
theorem chartField_eq_fderiv_sliceParam (u : Z) {q : N} (hq : q.1 ∈ σ.φ.source) :
    chartField σ u q = fderiv ℝ (sliceParam σ) (σ.φ q).1 u := by
  have h2 : (σ.φ q).2 = 0 := (σ.slice q hq).1 q.2
  have hz : (σ.φ q).1 ∈ σ.toChart.target := toChart_apply_mem_target σ hq
  rw [fderiv_sliceParam_apply σ hz, chartField]
  congr 2
  exact Prod.ext rfl h2

/-- The coordinate fields are tangent to `N` along `N`. -/
theorem chartField_mem_tangentSubspace (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) (u : Z)
    {q : N} (hq : q.1 ∈ σ.φ.source) : chartField σ u q ∈ tangentSubspace hN q := by
  rw [tangentSubspace_eq_range_fderiv_sliceParam hN σ hq, chartField_eq_fderiv_sliceParam σ u hq]
  exact ⟨u, rfl⟩

/-- At a point `q` which is not critical for `F|N`, some coordinate field of a slice chart around
`q` has `dF > 0` at `q`. -/
theorem exists_chartField_pos (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) {F : V → ℝ}
    {q : N} (hq : q.1 ∈ σ.φ.source) (hF : DifferentiableAt ℝ F q)
    (hcrit : letI := hN.chartedSpace; ¬IsCriticalPointM Z (F ∘ Subtype.val) q) :
    ∃ u : Z, 0 < fderiv ℝ F q (chartField σ u q) := by
  rw [isCriticalPointM_comp_val_iff_forall_tangent hN hF] at hcrit
  push Not at hcrit
  obtain ⟨v, hv, hFv⟩ := hcrit
  rw [tangentSubspace_eq_range_fderiv_sliceParam hN σ hq] at hv
  obtain ⟨w, rfl⟩ := hv
  have hw : chartField σ w q = fderiv ℝ (sliceParam σ) (σ.φ q).1 w :=
    chartField_eq_fderiv_sliceParam σ w hq
  rcases hFv.lt_or_gt with h | h
  · refine ⟨-w, ?_⟩
    rw [chartField_neg, map_neg, hw]
    exact neg_pos.2 h
  · exact ⟨w, by rw [hw]; exact h⟩

end ChartField

/-! ### The chart domain of `N` -/

variable (Z W) in
/-- The union of the domains of all slice charts of `N`: an open set containing `N`, in which `N` is
closed. -/
def chartDomain (N : Set V) : Set V :=
  ⋃ σ : Milnor.SliceChart 𝓘(ℝ, V) Z W N, σ.φ.source

theorem isOpen_chartDomain : IsOpen (chartDomain Z W N) :=
  isOpen_iUnion fun σ => σ.φ.open_source

theorem subset_chartDomain (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) :
    N ⊆ chartDomain Z W N := fun q hq => by
  obtain ⟨σ, hσ⟩ := hN q hq
  exact mem_iUnion.2 ⟨σ, hσ⟩

/-- `N` is closed in `chartDomain Z W N`. -/
theorem isOpen_chartDomain_diff : IsOpen (chartDomain Z W N \ N) := by
  rw [isOpen_iff_forall_mem_open]
  rintro x ⟨hx, hxN⟩
  obtain ⟨σ, hσ⟩ := mem_iUnion.1 hx
  have h2 : (σ.φ x).2 ≠ 0 := fun h => hxN ((σ.slice x hσ).2 h)
  have hcont : ContinuousOn (fun y => (σ.φ y).2) σ.φ.source :=
    continuous_snd.comp_continuousOn (contDiffOn_sliceChart σ).continuousOn
  refine ⟨σ.φ.source ∩ (fun y => (σ.φ y).2) ⁻¹' {0}ᶜ, ?_, ?_, ⟨hσ, h2⟩⟩
  · rintro y ⟨hy, hy2⟩
    exact ⟨mem_iUnion.2 ⟨σ, hy⟩, fun hyN => hy2 ((σ.slice y hy).1 hyN)⟩
  · exact hcont.isOpen_inter_preimage σ.φ.open_source isOpen_compl_singleton

/-! ### A tangent field along which `F` increases -/

variable [FiniteDimensional ℝ V]

/-- **Step 1.** If `F|N` has no critical point on the compact set `K ⊆ N`, there is a smooth vector
field `Y` on `V`, tangent to `N` at every point of `N`, with `dF(Y) > 0` on `K`. -/
theorem exists_tangent_field (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) {F : V → ℝ}
    (hF : ContDiff ℝ ∞ F) {K : Set V} (hK : IsCompact K) (hKN : K ⊆ N)
    (hcrit : letI := hN.chartedSpace;
      ∀ q : N, (q : V) ∈ K → ¬IsCriticalPointM Z (F ∘ Subtype.val) q) :
    ∃ Y : V → V, ContDiff ℝ ∞ Y ∧ (∀ q : N, Y q ∈ tangentSubspace hN q) ∧
      ∀ x ∈ K, 0 < fderiv ℝ F x (Y x) := by
  have hdF : ContDiff ℝ ∞ (fderiv ℝ F) := hF.fderiv_right (by simp)
  -- around each point of `K`: a chart, a direction, and a bump inside the region where `dF > 0`
  have hloc : ∀ q ∈ K, ∃ (σ : Milnor.SliceChart 𝓘(ℝ, V) Z W N) (u : Z) (χ : V → ℝ),
      ContDiff ℝ ∞ χ ∧ (∀ x, 0 ≤ χ x) ∧ 0 < χ q ∧ tsupport χ ⊆ σ.φ.source ∧
        ∀ x ∈ tsupport χ, 0 < fderiv ℝ F x (chartField σ u x) := by
    intro q hq
    obtain ⟨σ, hσ⟩ := hN q (hKN hq)
    obtain ⟨u, hu⟩ := exists_chartField_pos σ hN (q := ⟨q, hKN hq⟩) hσ
      ((hF.differentiable (by simp)) q) (hcrit ⟨q, hKN hq⟩ hq)
    have hcont : ContinuousOn (fun x => fderiv ℝ F x (chartField σ u x)) σ.φ.source :=
      (hdF.continuous.continuousOn.clm_apply (contDiffOn_chartField σ u).continuousOn)
    have hUo : IsOpen (σ.φ.source ∩ (fun x => fderiv ℝ F x (chartField σ u x)) ⁻¹' Ioi 0) :=
      hcont.isOpen_inter_preimage σ.φ.open_source isOpen_Ioi
    obtain ⟨χ, hχU, -, hχ, hχr, hχq⟩ :=
      exists_contDiff_tsupport_subset (n := ⊤) (hUo.mem_nhds ⟨hσ, hu⟩)
    exact ⟨σ, u, χ, hχ, fun x => (hχr (mem_range_self x)).1, by rw [hχq]; exact one_pos,
      fun x hx => (hχU hx).1, fun x hx => (hχU hx).2⟩
  choose σ u χ hχ hχ0 hχq hχσ hχF using hloc
  -- a finite subcover of `K` by the sets `{χ_q > 0}`
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun i : K => {x | 0 < χ i.1 i.2 x})
    (fun i => isOpen_lt continuous_const (hχ i.1 i.2).continuous)
    (fun q hq => mem_iUnion.2 ⟨⟨q, hq⟩, hχq q hq⟩)
  refine ⟨fun x => ∑ i ∈ t, χ i.1 i.2 x • chartField (σ i.1 i.2) (u i.1 i.2) x, ?_, ?_, ?_⟩
  · exact ContDiff.sum fun i _ => contDiff_smul_of_tsupport (σ i.1 i.2).φ.open_source
      (hχ i.1 i.2) (contDiffOn_chartField _ _) (hχσ i.1 i.2)
  · intro q
    refine Submodule.sum_mem _ fun i _ => ?_
    by_cases h : χ i.1 i.2 q = 0
    · rw [h, zero_smul]
      exact Submodule.zero_mem _
    · exact Submodule.smul_mem _ _ (chartField_mem_tangentSubspace _ hN _
        (hχσ i.1 i.2 (subset_tsupport _ h)))
  · intro x hx
    simp only [map_sum, map_smul, smul_eq_mul]
    obtain ⟨i, hi, hix⟩ := mem_iUnion₂.1 (ht hx)
    refine Finset.sum_pos' (fun j _ => ?_) ⟨i, hi, ?_⟩
    · by_cases h : χ j.1 j.2 x = 0
      · rw [h, zero_mul]
      · exact mul_nonneg (hχ0 _ _ x) (hχF _ _ x (subset_tsupport _ h)).le
    · exact mul_pos hix (hχF _ _ x (subset_tsupport _ hix.ne'))

/-! ### Invariance of `N` under the flow of a tangent field -/

variable [FiniteDimensional ℝ Z]

omit [FiniteDimensional ℝ V] in
/-- **Local integral curves inside `N`.** A smooth field `X` on `V` which is tangent to `N` along
`N` has, through every point of `N`, a local integral curve which stays in `N`: in a slice chart,
solve the ODE `z' = (dφ X)₁` in `Z` and map the solution back by `z ↦ φ⁻¹(z, 0)`. -/
theorem exists_integralCurve_mem (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) {X : V → V}
    (hX : ContDiff ℝ ∞ X) (hXN : ∀ q : N, X q ∈ tangentSubspace hN q) {y : V} (hy : y ∈ N) :
    ∃ ε > 0, ∃ γ : ℝ → V, γ 0 = y ∧ ∀ t ∈ Ioo (-ε) ε, HasDerivAt γ (X (γ t)) t ∧ γ t ∈ N := by
  obtain ⟨σ, hσ⟩ := hN y hy
  -- the field read in the chart
  let Y : Z → Z := fun z => (fderiv ℝ σ.φ (sliceParam σ z) (X (sliceParam σ z))).1
  have hz₀ : (σ.φ y).1 ∈ σ.toChart.target := toChart_apply_mem_target σ (q := ⟨y, hy⟩) hσ
  have hy₀ : sliceParam σ (σ.φ y).1 = y := sliceParam_toChart σ (q := ⟨y, hy⟩) hσ
  -- `Y` is read back by the parametrization as `X`
  have hYX : ∀ z ∈ σ.toChart.target, fderiv ℝ (sliceParam σ) z (Y z) = X (sliceParam σ z) := by
    intro z hz
    have hz' : (z, (0 : W)) ∈ σ.φ.target := hz
    have hqN : sliceParam σ z ∈ N := sliceParam_mem σ hz
    have hqs : sliceParam σ z ∈ σ.φ.source := σ.φ.invFun_mem hz'
    have hφq : σ.φ (sliceParam σ z) = (z, 0) := σ.φ.apply_invFun hz'
    have hT := hXN ⟨sliceParam σ z, hqN⟩
    rw [tangentSubspace_eq_range_fderiv_sliceParam hN σ (q := ⟨_, hqN⟩) hqs] at hT
    obtain ⟨w, hw⟩ := hT
    simp only [hφq] at hw
    have hw' : X (sliceParam σ z) = fderiv ℝ σ.φ.invFun (σ.φ (sliceParam σ z)) (w, 0) := by
      rw [← hw]
      change fderiv ℝ (sliceParam σ) z w = _
      rw [fderiv_sliceParam_apply σ hz, hφq]
    have hYz : Y z = w := by
      change (fderiv ℝ σ.φ (sliceParam σ z) (X (sliceParam σ z))).1 = w
      rw [hw', fderiv_sliceChart_fderiv_invFun σ hqs]
    rw [hYz, ← hw]
    rfl
  -- `Y` is `C¹` at the base point
  have hY : ContDiffAt ℝ 1 Y (σ.φ y).1 := by
    have hP := contDiffAt_sliceParam σ hz₀
    have hD : ContDiffAt ℝ ∞ (fderiv ℝ σ.φ) (sliceParam σ (σ.φ y).1) := by
      rw [hy₀]
      exact ((contDiffOn_sliceChart σ).fderiv_of_isOpen σ.φ.open_source (by simp)).contDiffAt
        (σ.φ.open_source.mem_nhds hσ)
    have h1 : ContDiffAt ℝ ∞ (fun z => fderiv ℝ σ.φ (sliceParam σ z) (X (sliceParam σ z)))
        (σ.φ y).1 := (hD.comp _ hP).clm_apply (hX.contDiffAt.comp _ hP)
    exact (contDiff_fst.contDiffAt.comp _ h1).of_le (by simp)
  obtain ⟨α, hα0, ε, hε, hα⟩ :=
    hY.exists_forall_mem_closedBall_exists_eq_forall_mem_Ioo_hasDerivAt₀ 0
  -- the solution stays in the chart for small times
  have hαc : ContinuousAt α 0 := (hα 0 (by simp [hε])).continuousAt
  obtain ⟨δ, hδ, hδT⟩ := Metric.eventually_nhds_iff.1 (hαc.preimage_mem_nhds
    ((isOpen_toChart_target σ).mem_nhds (by rw [hα0]; exact hz₀)))
  refine ⟨min ε δ, lt_min hε hδ, fun t => sliceParam σ (α t), by simp only [hα0, hy₀],
    fun t ht => ?_⟩
  have htT : α t ∈ σ.toChart.target := hδT (by
    rw [Real.dist_eq, sub_zero, abs_lt]
    exact ⟨(neg_le_neg (min_le_right _ _)).trans_lt ht.1, ht.2.trans_le (min_le_right _ _)⟩)
  have htε : t ∈ Ioo (0 - ε) (0 + ε) := by
    rw [zero_sub, zero_add]
    exact ⟨(neg_le_neg (min_le_left _ _)).trans_lt ht.1, ht.2.trans_le (min_le_left _ _)⟩
  refine ⟨?_, sliceParam_mem σ htT⟩
  have h1 : HasFDerivAt (sliceParam σ) (fderiv ℝ (sliceParam σ) (α t)) (α t) :=
    ((contDiffAt_sliceParam σ htT).differentiableAt (by simp)).hasFDerivAt
  have h2 := h1.comp_hasDerivAt t (hα t htε)
  rw [hYX _ htT] at h2
  exact h2

/-- **Invariance of `N`.** The flow of a smooth compactly supported field `X` which is tangent to
`N` along `N` and vanishes outside the chart domain of `N` preserves `N`. -/
theorem flow_mem_of_tangent (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) {X : V → V}
    (hX : ContDiff ℝ ∞ X) (hXs : HasCompactSupport X)
    (hXN : ∀ q : N, X q ∈ tangentSubspace hN q) (hXO : tsupport X ⊆ chartDomain Z W N) {x : V}
    (hx : x ∈ N) (t : ℝ) : flow X t x ∈ N := by
  have hb := IsBddLipschitz.of_contDiff (hX.of_le (by simp)) hXs
  set O := chartDomain Z W N
  have hS : IsClosed (N ∪ Oᶜ) := by
    rw [← isOpen_compl_iff, compl_union, compl_compl, inter_comm]
    exact isOpen_chartDomain_diff
  have hzero : ∀ y ∉ O, X y = 0 := fun y hy =>
    image_eq_zero_of_notMem_tsupport fun h => hy (hXO h)
  have hloc : ∀ y ∈ N ∪ Oᶜ, ∃ ε > 0, ∃ γ : ℝ → V, γ 0 = y ∧
      ∀ t ∈ Ioo (-ε) ε, HasDerivAt γ (X (γ t)) t ∧ γ t ∈ N ∪ Oᶜ := by
    rintro y (hy | hy)
    · obtain ⟨ε, hε, γ, hγ0, hγ⟩ := exists_integralCurve_mem hN hX hXN hy
      exact ⟨ε, hε, γ, hγ0, fun t ht => ⟨(hγ t ht).1, Or.inl (hγ t ht).2⟩⟩
    · refine ⟨1, one_pos, fun _ => y, rfl, fun t _ => ⟨?_, Or.inr hy⟩⟩
      rw [hzero y hy]
      exact hasDerivAt_const t y
  rcases hb.flow_mem hS hloc (Or.inl hx) t with h | h
  · exact h
  · -- a trajectory through a zero of `X` is constant, so it cannot come from `N ⊆ O`
    have h1 := hb.flow_of_eq_zero (hzero _ h) (-t)
    rw [hb.flow_neg_flow] at h1
    exact absurd (subset_chartDomain hN hx) (h1 ▸ h)

/-! ### Theorem 3.1 on a submanifold -/

/-- **Milnor's Theorem 3.1 for a submanifold of Euclidean space.** Let `N ⊆ V` be a slice
submanifold of the finite-dimensional real normed space `V`, `F : V → ℝ` smooth and `f = F|N`.
Suppose `a ≤ b` and that `f⁻¹[a, b]` is compact and contains no critical point of `f`. Then

1. there is a `C^∞` diffeomorphism `Φ` of the manifold `N` with `Φ(N^a) = N^b` (the time-`(b - a)`
   map of a flow of `N`);
2. `N^a` is a strong deformation retract of `N^b`;
3. the inclusion `N^a → N^b` is a homotopy equivalence. -/
theorem theorem_3_1_submanifold (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N) {F : V → ℝ}
    (hF : ContDiff ℝ ∞ F) {a b : ℝ} (hab : a ≤ b)
    (hK : IsCompact ((F ∘ Subtype.val : N → ℝ) ⁻¹' Icc a b))
    (hcrit : letI := hN.chartedSpace;
      ∀ q : N, F q ∈ Icc a b → ¬IsCriticalPointM Z (F ∘ Subtype.val) q) :
    letI := hN.chartedSpace
    (∃ Φ : Diffeomorph 𝓘(ℝ, Z) 𝓘(ℝ, Z) N N ∞,
        Φ '' sublevel (F ∘ Subtype.val) a = sublevel (F ∘ Subtype.val) b) ∧
      IsStrongDeformationRetract (Subtype.val ⁻¹' sublevel (F ∘ Subtype.val : N → ℝ) a :
        Set (sublevel (F ∘ Subtype.val : N → ℝ) b)) ∧
      ∃ e : ContinuousMap.HomotopyEquiv (sublevel (F ∘ Subtype.val : N → ℝ) a)
          (sublevel (F ∘ Subtype.val : N → ℝ) b),
        ⇑e = Set.inclusion (sublevel_mono _ hab) := by
  let _ := hN.chartedSpace
  have := hN.isManifold
  -- the compact set `K = N ∩ F⁻¹[a, b]` in `V`
  set K : Set V := Subtype.val '' ((F ∘ Subtype.val : N → ℝ) ⁻¹' Icc a b) with hK_def
  have hKc : IsCompact K := hK.image continuous_subtype_val
  have hKN : K ⊆ N := by
    rintro _ ⟨q, -, rfl⟩
    exact q.2
  have hKF : ∀ x ∈ K, F x ∈ Icc a b := by
    rintro _ ⟨q, hq, rfl⟩
    exact hq
  -- steps 1 and 2: the field `X = ρ Y`
  obtain ⟨Y, hY, hYN, hYpos⟩ := exists_tangent_field hN hF hKc hKN
    fun q hq => hcrit q (hKF _ hq)
  have hg : ContDiff ℝ ∞ fun x => fderiv ℝ F x (Y x) :=
    (hF.fderiv_right (by simp)).clm_apply hY
  obtain ⟨ρ, hρ, hρs, hρO, -, hρK⟩ := exists_cutoff_mul hg hKc isOpen_chartDomain
    (hKN.trans (subset_chartDomain hN)) fun x hx => (hYpos x hx).ne'
  set X : V → V := fun x => ρ x • Y x with hX_def
  have hX : ContDiff ℝ ∞ X := hρ.smul hY
  have hXs : HasCompactSupport X := hρs.smul_right
  have hXN : ∀ q : N, X q ∈ tangentSubspace hN q := fun q => Submodule.smul_mem _ _ (hYN q)
  have hXO : tsupport X ⊆ chartDomain Z W N := (tsupport_smul_subset_left _ _).trans hρO
  have hXF : ∀ x ∈ K, fderiv ℝ F x (X x) = 1 := fun x hx => by
    rw [hX_def, map_smul, smul_eq_mul, hρK x hx]
  have hb := IsBddLipschitz.of_contDiff (hX.of_le (by simp)) hXs
  -- step 3: the flow preserves `N`
  have hinv : ∀ x ∈ N, ∀ t, flow X t x ∈ N := fun x hx t =>
    flow_mem_of_tangent hN hX hXs hXN hXO hx t
  let φ : ℝ → N → N := fun t q => ⟨flow X t q, hinv q q.2 t⟩
  -- step 4: a slab flow on `N`
  have hslab : IsSlabFlow (F ∘ Subtype.val : N → ℝ) a b φ :=
    { continuous := (hb.continuous_flow.comp (continuous_fst.prodMk
        (continuous_subtype_val.comp continuous_snd))).subtype_mk _
      zero := fun q => Subtype.ext (hb.flow_zero q)
      add := fun s t q => Subtype.ext (hb.flow_add s t q)
      continuous_F := hF.continuous.comp continuous_subtype_val
      hasDerivAt := fun q t ht => by
        have h1 := ((hF.differentiable (by simp)) (flow X t q)).hasFDerivAt.comp_hasDerivAt t
          (hb.hasDerivAt_flow t q)
        rw [hXF _ ⟨φ t q, ht, rfl⟩] at h1
        exact h1 }
  have hsmooth : ∀ t, ContMDiff 𝓘(ℝ, Z) 𝓘(ℝ, Z) ∞ (φ t) := fun t =>
    hN.contMDiff_codRestrict ((contDiff_flow (n := ⊤) hX le_top hXs t).contMDiff.comp
      hN.contMDiff_val) _
  let Φ : Diffeomorph 𝓘(ℝ, Z) 𝓘(ℝ, Z) N N ∞ :=
    { toFun := φ (b - a)
      invFun := φ (-(b - a))
      left_inv := fun q => Subtype.ext (hb.flow_neg_flow _ q)
      right_inv := fun q => Subtype.ext (hb.flow_flow_neg _ q)
      contMDiff_toFun := hsmooth _
      contMDiff_invFun := hsmooth _ }
  exact ⟨⟨Φ, hslab.image_sublevel le_rfl hab le_rfl⟩, hslab.isStrongDeformationRetract,
    hslab.exists_homotopyEquiv hab⟩

/-- **Theorem 3.1 for a compact submanifold** `N ⊆ V`: the compactness of `f⁻¹[a, b]` is then
automatic (a closed subset of the compact space `N`). -/
theorem theorem_3_1_submanifold_of_isCompact (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N)
    (hNc : IsCompact N) {F : V → ℝ} (hF : ContDiff ℝ ∞ F) {a b : ℝ} (hab : a ≤ b)
    (hcrit : letI := hN.chartedSpace;
      ∀ q : N, F q ∈ Icc a b → ¬IsCriticalPointM Z (F ∘ Subtype.val) q) :
    letI := hN.chartedSpace
    (∃ Φ : Diffeomorph 𝓘(ℝ, Z) 𝓘(ℝ, Z) N N ∞,
        Φ '' sublevel (F ∘ Subtype.val) a = sublevel (F ∘ Subtype.val) b) ∧
      IsStrongDeformationRetract (Subtype.val ⁻¹' sublevel (F ∘ Subtype.val : N → ℝ) a :
        Set (sublevel (F ∘ Subtype.val : N → ℝ) b)) ∧
      ∃ e : ContinuousMap.HomotopyEquiv (sublevel (F ∘ Subtype.val : N → ℝ) a)
          (sublevel (F ∘ Subtype.val : N → ℝ) b),
        ⇑e = Set.inclusion (sublevel_mono _ hab) :=
  haveI := isCompact_iff_compactSpace.1 hNc
  theorem_3_1_submanifold hN hF hab
    (isClosed_Icc.preimage (hF.continuous.comp continuous_subtype_val)).isCompact hcrit

end Morse
