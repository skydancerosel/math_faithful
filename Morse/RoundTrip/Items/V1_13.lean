import Morse
import RoundTrip.Check
import RoundTrip.Blind.V1_13

namespace RoundTrip.V1_13

/-- The project's statement: the types of the two listed theorems (`IsOneParameterGroup` and
`Generates` are vocabulary), universes instantiated at `0`. -/
def A : Prop :=
  (type_of% @Morse.IsOneParameterGroup.zero.{0}) ∧
  (type_of% @Morse.IsOneParameterGroup.isIntegralCurve.{0})

theorem A_holds : A :=
  ⟨@Morse.IsOneParameterGroup.zero.{0}, @Morse.IsOneParameterGroup.isIntegralCurve.{0}⟩

/-- `B ⇒ A`. `A` is elementary (`φ₀ = id`, and orbits of a group generated by `X` in the
`HasDerivAt` sense are integral curves), and holds in every normed space, including
infinite-dimensional ones that `B` (finite-dimensional manifolds) does not reach; so it is
re-proved directly from the definitions, without using `B` or the item's theorems. -/
theorem B_to_A : B → A := by
  intro _
  refine ⟨fun {E} _ _ φ hφ x => ?_, fun {E} _ _ X φ hφ hX x => ?_⟩
  · obtain ⟨e, he⟩ := hφ.diffeo 0
    have h : φ 0 (φ 0 x) = φ 0 x := by
      have := congrFun (hφ.add 0 0) x
      rw [add_zero] at this
      exact this.symm
    rw [← he] at h ⊢
    exact e.injective h
  · intro t
    have h1 : (fun s => φ s x) = fun s => φ (s - t) (φ t x) := funext fun s => by
      rw [← Function.comp_apply (f := φ (s - t)), ← hφ.add, sub_add_cancel]
    have h2 := hX (φ t x)
    rw [← sub_self t] at h2
    have h3 : HasDerivAt (fun s => φ (s - t) (φ t x)) (X (φ t x)) t := h2.comp_sub_const t t
    rw [← h1] at h3
    exact h3

#rt_check RoundTrip.V1_13.B_to_A [Morse.IsOneParameterGroup.zero,
  Morse.IsOneParameterGroup.isIntegralCurve]
#rt_overlap RoundTrip.V1_13.B_to_A [Morse.IsOneParameterGroup.zero,
  Morse.IsOneParameterGroup.isIntegralCurve]

end RoundTrip.V1_13
