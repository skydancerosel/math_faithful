import Morse
import RoundTrip.Check
import RoundTrip.Blind.V15_31

namespace RoundTrip.V15_31

/-- The project's statement (universe instantiated at `0`, arbitrary finite `ι`,
`IsAnticommFamily J (k + 1)`, `k + 1 ≤ 8`, `k + 1 ≢ 3 (mod 4)`, `r₀ = 1` or `(r₀ = 2, k = 0)`,
`i + 2 ≤ r₀ (n / m_{k+1} − 1)`): (1) `omega_theorem_22_1_bijective`: the inclusion of the minimal
geodesics `minPaths → PathSp (omegaStratum J k J_k) J_k (−J_k)` is bijective on `π_i` at every
point; (2) `omegaPhi_bijective`: Milnor's `φ_r : Ω_{k+1}(n) → PathSp …`,
`J' ↦ (t ↦ cos(πt)J_k + sin(πt)J')`, is bijective on `π_i` at every `J'` (pointed sets);
(3) `isClopen_stratumIn`, `nonempty_pi_stratum_equiv`: the stratum of `p` is clopen in `Ω_k(n)`
and has the same `π_{j+1}` as `Ω_k(n)` at its points (for ANY `p`, `IsAnticommFamily J k`);
(4) `omega_pi_equiv`: `π_i(Ω_{k+1}(n), J') ≃ π_{i+1}(Ω_k(n), J_k)` as sets. -/
def A : Prop :=
  type_of% @Morse.omega_theorem_22_1_bijective.{0} ∧ type_of% @Morse.omegaPhi_bijective.{0} ∧
    type_of% @Morse.isClopen_stratumIn.{0} ∧ type_of% @Morse.nonempty_pi_stratum_equiv.{0} ∧
    type_of% @Morse.omega_pi_equiv.{0}

theorem A_holds : A :=
  ⟨@Morse.omega_theorem_22_1_bijective.{0}, @Morse.omegaPhi_bijective.{0},
    @Morse.isClopen_stratumIn.{0}, @Morse.nonempty_pi_stratum_equiv.{0},
    @Morse.omega_pi_equiv.{0}⟩

/-- Vocabulary: B's `mK` is the project's `milnorM`. -/
theorem mK_eq_milnorM : ∀ k, mK k = Morse.milnorM k
  | 0 => rfl
  | 1 => rfl
  | 2 => rfl
  | 3 => rfl
  | 4 => rfl
  | 5 => rfl
  | 6 => rfl
  | 7 => rfl
  | k + 8 => by rw [mK, mK_eq_milnorM k]; rfl

/-- B's range `(i + 3)·m_{k+1} ≤ n` is A's `i + 2 ≤ 1·(n / m_{k+1} − 1)` (`r₀ = 1`). -/
theorem range_iff (i n m : ℕ) (hm : 0 < m) : (i + 3) * m ≤ n ↔ i + 2 ≤ 1 * (n / m - 1) := by
  rw [one_mul, ← Nat.le_div_iff_mul_le hm]
  omega

/-! Neither direction is proved (see `Items/V15_31.json`).

* A ⇒ B: A covers only `k + 1 ≤ 8` (B: every `k ≥ 1` with `k ≢ 2 mod 4`; genuinely missing for
  `k ≥ 8`); A's bijections are of pointed sets (B also asks for group isomorphisms for `i ≥ 1`;
  that part is only effort: the project's `homotopyGroupMap_mul` makes a bijective `φ_*` a
  group isomorphism); and A's path space is the project's `PathSp (omegaStratum J k J_k)` with
  Milnor's metric as a pseudo-emetric (paths not normalized off `[0,1]`, the stratum instead of
  `Ω_k(n)`, `riemDist`, `IsPiecewiseSmooth`), B's is `OmIn (Ω_k(n))` (normalized paths, the
  topology generated by the balls of the blind `dOmIn` built from `rhoIn`, `IsPWOn`): the
  homotopy equivalence between them commuting with `φ_r`/`j` is believed true but not built.
* B ⇒ A: B has no `k = 0` case (A's `r₀ = 2, k = 0` and `r₀ = 1, k = 0` cases are Theorem 24.3,
  `V15_32`), no statement about the minimal-geodesic space `minPaths` (A's (1); derivable from
  B's bijectivity only with the project's homotopy equivalence `Ω_{k+1} ≃ minPaths` and the same
  path-space glue), no loop-space form `π_{i+1}Ω_k(n)` (A's (4), Corollary 22.2), and A's (3) are
  general facts about strata absent from B. -/

end RoundTrip.V15_31
