#rt_check RoundTrip.V10_19.B2_emb_to_A_emb [Morse.isHomotopyDirectLimit_preimage, Morse.theoremA_general, Morse.JoinSystem.isHomotopyEquiv_toPathC, Morse.theorem_17_1]
#rt_overlap RoundTrip.V10_19.B2_emb_to_A_emb [Morse.isHomotopyDirectLimit_preimage, Morse.theoremA_general, Morse.JoinSystem.isHomotopyEquiv_toPathC, Morse.theorem_17_1]
#rt_overlap RoundTrip.V10_19.A_to_B2_emb [Morse.isHomotopyDirectLimit_preimage, Morse.theoremA_general, Morse.JoinSystem.isHomotopyEquiv_toPathC, Morse.theorem_17_1]

