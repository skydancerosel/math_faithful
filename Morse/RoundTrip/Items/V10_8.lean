import Morse
import RoundTrip.Check
import RoundTrip.Blind.V10_8
import RoundTrip.Bridge

open Set Filter Topology Function
open scoped ContDiff Manifold

namespace RoundTrip.V10_8

/-- The data-valued declaration `Morse.BrokenSetup.homotopyEquivBroken` (`Ω^a ≃ₕ B^a`, `a < c`),
recorded through `Nonempty` of its type. -/
def A5 : Prop :=
  ∀ {V : Type} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {Z : Type} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [FiniteDimensional ℝ Z]
    {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]
    {N : Set V} {hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) Z W N} {p q : V} {c : ℝ} {m : ℕ}
    (S : Morse.BrokenSetup hN p q c m) {a : ℝ}, a < c →
    Nonempty (ContinuousMap.HomotopyEquiv
      {γ : Morse.PathSp N p q // Morse.energy γ 0 1 ≤ a}
      {γ : Morse.PathSp N p q // Morse.energy γ 0 1 ≤ a ∧ (γ : ℝ → V) ∈ S.brokenPaths})

/-- The project's statement (universes instantiated at `0`): properties of the project's specific
deformation `deform` (`r_u` on `[0, 1]`, `γ` off `[0, 1]`; vocabulary): `r_0 = id`,
`E(r_u γ) ≤ E(γ)`, `r_1(Int Ω^c) ⊆ B`, Theorem 16.2's deformation-retract package for
`B^a ⊆ Ω^a` (`a < c`: continuity on `[0, 1] × Ω^a`, energy non-increasing, `r_0 = id`,
`r_1(Ω^a) ⊆ B`, `r_u` fixes `B`), and `Ω^a ≃ₕ B^a` (`A5`). -/
def A : Prop :=
  type_of% @Morse.BrokenSetup.deform_zero.{0,0,0} ∧
    type_of% @Morse.BrokenSetup.energy_deform_le.{0,0,0} ∧
    type_of% @Morse.BrokenSetup.deform_one_mem_brokenPaths.{0,0,0} ∧
    type_of% @Morse.BrokenSetup.theorem_16_2_deformationRetract.{0,0,0} ∧ A5

theorem A_holds : A :=
  ⟨@Morse.BrokenSetup.deform_zero, @Morse.BrokenSetup.energy_deform_le,
    @Morse.BrokenSetup.deform_one_mem_brokenPaths, @Morse.BrokenSetup.theorem_16_2_deformationRetract,
    fun S _ ha => ⟨S.homotopyEquivBroken ha⟩⟩

/-! Neither direction is proved (see `V10_8.json`).

* `A → B` fails genuinely: B quantifies over abstract connected Hausdorff `ℝⁿ`-manifolds with any
  smooth metric and Levi-Civita connection; A only over slice submanifolds `N ⊆ V`.
* `B → A` fails genuinely: A's first four conjuncts are about the project's specific `deform`;
  B only asserts that some deformation retraction exists. The only comparable conjunct is `A5`
  (homotopy equivalence `Ω^a ≃ₕ B^a`), which B's strong deformation retraction would give on
  embedded manifolds, through the dictionaries listed below.

## The embedded special case

`B_emb` (B for `M = ↥N` with the induced connection, `B_to_B_emb`). `A → B_emb` would be
"take `H(s, ω) := deform s ω`, transported to the blind `Ω`" — but only for data coming from a
`Morse.BrokenSetup`, and B's `Setup16` does not provide one: the project additionally requires
that `δ = ε` be at most a normal radius at every point of `S`, `IsShortJoin` (Corollary 10.8 with
minimality and a smooth representative on an open set of `V × V`) and compactness of `S`; the
normal-radius condition does not follow from B's `ShortGood` (unit sphere, small cap `S`,
`π < ε`). Even with B's data restricted to those of a `BrokenSetup`, the transport needs three
dictionaries not in the Bridge: (i) the blind `Ω` (functions `ℝ → ↥N`, topology generated by the
`d`-balls) vs `Morse.PathSp N p q` (Milnor's pseudo-emetric; `Items/V10_1.lean` has
`d = edist`, from which one gets that the blind topology is induced by `w ↦ incl ∘ w`); (ii) the
blind `B = Int Ω(t₀..t_k)^c` (blind geodesic on each *closed* `[tᵢ, t_{i+1}]`) vs
`BrokenSetup.brokenPaths` (`IsGeodesicOn` on each *open* `(tᵢ, t_{i+1})`, piecewise smooth; the
endpoint condition by continuity, as `Items/V8_10.lean` does on `[0, 1]`); (iii) `ℕ`-indexed `t`
vs `Fin (m + 2)`-indexed `Subdivision.t`. Then `H s a = a` on `B^a` is `deform_of_mem_brokenPaths`
(conjunct 5 of `theorem_16_2_deformationRetract`), exactly, since `deform` is `γ` off `[0, 1]`. -/

/-- **B on embedded manifolds**: `M = ↥N` (`Bridge.Sub hN`, model `ℝⁿ`, induced metric) with the
induced Levi-Civita connection `Bridge.conn`. -/
def B_emb : Prop :=
  ∀ (V : Type) [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    (W : Type) [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W] (n : ℕ)
    (N : Set V) (hN : Milnor.IsSliceSubmanifold 𝓘(ℝ, V) (Rn n) W N)
    [ConnectedSpace (Bridge.Sub hN)], MetricComplete n (Bridge.Sub hN) →
    ∀ (p q : Bridge.Sub hN) (c ε : ℝ) (k : ℕ) (t : ℕ → ℝ),
      Setup16 n (Bridge.conn (hN := hN)) p q c ε k t →
      (∀ a : ℝ, a < c → IsDefRetract (OmLe n p q a) (BsetA n (Bridge.conn (hN := hN)) p q c k t a)) ∧
      IsDefRetract (IntOm n p q c) (Bset n (Bridge.conn (hN := hN)) p q c k t)

theorem B_to_B_emb : B → B_emb := fun hB _ _ _ _ _ _ _ _ n _ hN _ =>
  hB n (Bridge.Sub hN) (Bridge.conn (hN := hN)) Bridge.conn_isLC

end RoundTrip.V10_8
