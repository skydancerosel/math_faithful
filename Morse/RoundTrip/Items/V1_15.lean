import Morse
import RoundTrip.Check
import RoundTrip.Blind.V1_15

open scoped ContDiff Manifold
open Function

namespace RoundTrip.V1_15

/-- The project's statement (Lemma 2.4 for `M = E`), universe instantiated at `0`. -/
def A : Prop := type_of% @Morse.lemma_2_4.{0}

theorem A_holds : A := @Morse.lemma_2_4.{0}

section Aux

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Orbits of a 1-parameter group generated by `X` have derivative `X` everywhere. -/
theorem hasDerivAt_orbit {X : E → E} {ψ : ℝ → E → E} (hadd : ∀ s t, ψ (s + t) = ψ s ∘ ψ t)
    (hX : ∀ x, HasDerivAt (fun h => ψ h x) (X x) 0) (x : E) (t : ℝ) :
    HasDerivAt (fun s => ψ s x) (X (ψ t x)) t := by
  have h1 : (fun s => ψ s x) = fun s => ψ (s - t) (ψ t x) := funext fun s => by
    rw [← Function.comp_apply (f := ψ (s - t)), ← hadd, sub_add_cancel]
  have h2 := hX (ψ t x)
  rw [← sub_self t] at h2
  rw [h1]
  exact h2.comp_sub_const t t

/-- A continuous compactly supported function on an infinite-dimensional space vanishes. -/
theorem eq_zero_of_not_finiteDimensional {X : E → E} (hc : Continuous X) (hs : HasCompactSupport X)
    (hE : ¬ FiniteDimensional ℝ E) (x : E) : X x = 0 := by
  by_contra hx
  have hopen : IsOpen (support X) := hc.isOpen_support
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 hopen x hx
  have hsub : Metric.closedBall x (r / 2) ⊆ tsupport X :=
    (Metric.closedBall_subset_ball (by linarith)).trans (hball.trans (subset_tsupport X))
  exact hE (FiniteDimensional.of_isCompact_closedBall ℝ (by linarith) (hs.of_isClosed_subset
    Metric.isClosed_closedBall hsub))

end Aux

theorem B_to_A : B → A := by
  intro hB E _ _ _ X hX hs
  by_cases hE : FiniteDimensional ℝ E
  · -- the finite-dimensional case: apply `B` to `M = E`
    have hsec : ContMDiff 𝓘(ℝ, E) (𝓘(ℝ, E).prod 𝓘(ℝ, E)) ∞
        (fun x : E => (⟨x, X x⟩ : TangentBundle 𝓘(ℝ, E) E)) := by
      intro x₀
      refine (Bundle.contMDiffAt_section (F := E) (E := TangentSpace 𝓘(ℝ, E)) x₀).2 ?_
      simp only [trivializationAt_model_space_apply]
      exact hX.contMDiff.contMDiffAt
    have hK : ∃ K : Set E, IsCompact K ∧ ∀ x, x ∉ K → X x = 0 :=
      ⟨tsupport X, hs, fun x hx => image_eq_zero_of_notMem_tsupport hx⟩
    obtain ⟨φ, ⟨hsm, h0, hadd, hgen⟩, huniq⟩ := hB E E X hsec hK
    -- translate between joint smoothness on the manifold `ℝ × E` and on the vector space
    have hiff : ∀ ψ : ℝ → E → E,
        ContMDiff (𝓘(ℝ).prod 𝓘(ℝ, E)) 𝓘(ℝ, E) ∞ (fun z : ℝ × E => ψ z.1 z.2) ↔
          ContDiff ℝ ∞ (fun z : ℝ × E => ψ z.1 z.2) := by
      intro ψ
      rw [← modelWithCornersSelf_prod, chartedSpaceSelf_prod]
      exact contMDiff_iff_contDiff
    have hcd := (hiff φ).1 hsm
    have hslice : ∀ t, ContDiff ℝ ∞ (φ t) := fun t =>
      hcd.comp (contDiff_const.prodMk contDiff_id)
    have hdiffx : ∀ x, Differentiable ℝ (fun s => φ s x) := fun x =>
      (hcd.comp (contDiff_id.prodMk contDiff_const)).differentiable (by simp)
    have haddf : ∀ s t, φ (s + t) = φ s ∘ φ t := fun s t => funext fun x => hadd s t x
    refine ⟨φ, ⟨⟨hcd, fun t => ?_, haddf⟩, fun x => ?_⟩, fun ψ ⟨hψ, hψX⟩ => ?_⟩
    · have hl : LeftInverse (φ (-t)) (φ t) := fun x => by rw [← hadd, neg_add_cancel, h0]
      have hr : RightInverse (φ (-t)) (φ t) := fun x => by rw [← hadd, add_neg_cancel, h0]
      exact ⟨{ toFun := φ t
               invFun := φ (-t)
               left_inv := hl
               right_inv := hr
               contMDiff_toFun := (hslice t).contMDiff
               contMDiff_invFun := (hslice (-t)).contMDiff }, rfl⟩
    · -- `X` generates `φ`: test against continuous linear functionals
      have hd := (hdiffx x 0).hasDerivAt
      convert hd using 1
      refine (SeparatingDual.eq_iff_forall_dual_eq (R := ℝ)).2 fun ℓ => ?_
      have h1 := hgen ℓ ℓ.contDiff.contMDiff x
      rw [mfderiv_eq_fderiv, ℓ.fderiv] at h1
      exact h1.symm.trans (ℓ.hasFDerivAt.comp_hasDerivAt 0 hd).deriv
    · -- uniqueness
      refine huniq ψ ⟨(hiff ψ).2 hψ.contDiff, hψ.zero, fun s t x => congrFun (hψ.add s t) x,
        fun g hg q => ?_⟩
      have hg' : ContDiff ℝ ∞ g := contMDiff_iff_contDiff.1 hg
      have h1 := ((hg'.differentiable (by simp)) (ψ 0 q)).hasFDerivAt.comp_hasDerivAt 0 (hψX q)
      rw [hψ.zero] at h1
      rw [mfderiv_eq_fderiv]
      exact h1.deriv
  · -- the infinite-dimensional case: `X = 0`, and the only group generated by `0` is `id`
    have hX0 : X = 0 := funext (eq_zero_of_not_finiteDimensional hX.continuous hs hE)
    subst hX0
    refine ⟨fun _ x => x, ⟨⟨contDiff_snd, fun _ => ⟨Diffeomorph.refl _ _ _, rfl⟩,
      fun _ _ => rfl⟩, fun x => hasDerivAt_const _ _⟩, fun ψ ⟨hψ, hψX⟩ => ?_⟩
    funext t x
    have hd := hasDerivAt_orbit hψ.add hψX x
    have hconst := is_const_of_deriv_eq_zero (f := fun s => ψ s x)
      (fun s => (hd s).differentiableAt) (fun s => (hd s).deriv)
    rw [hconst t 0, hψ.zero]

#rt_check RoundTrip.V1_15.B_to_A [Morse.lemma_2_4]
#rt_overlap RoundTrip.V1_15.B_to_A [Morse.lemma_2_4]

end RoundTrip.V1_15
