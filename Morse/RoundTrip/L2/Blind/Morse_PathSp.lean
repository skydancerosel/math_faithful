import Morse
/-! Layer-2 blind definition of Morse_PathSp. Textbook: Milnor, *Morse Theory*, §13, p. 67 and
§16, p. 88: `Ω = Ω(M; p, q)` is the set of piecewise smooth paths `ω : [0,1] → M` from `p` to
`q`, topologised by the metric
`d(ω, ω') = max_t ρ(ω(t), ω'(t)) + (∫₀¹ (ds/dt − ds'/dt)² dt)^{1/2}`,
where `ρ` is the Riemannian distance of `M`, `s(t) = ∫₀ᵗ ‖dω/dt‖` the arc length, so that
`ds/dt = ‖dω/dt‖` (off the break points).
Choices:
* `M` is the subset `N ⊆ V` with the metric induced by the inner product of `V` (the setting;
  no submanifold hypothesis is carried, none is needed to state the definition).
* A path is a function `ω : [0,1] → V` (on `unitInterval`) with values in `N`, `ω 0 = p`,
  `ω 1 = q`, piecewise smooth: its extension `ext ω = ω ∘ projIcc 0 1` (constant outside
  `[0,1]`) is `C^∞` on every closed `[a, b] ⊆ [0,1]` whose interior avoids a fixed finite set
  (equivalent to "smooth on each `[t_{i-1}, t_i]` of some subdivision `0 = t₀ < … < t_k = 1`").
* `ρ(x, y)` = infimum of the lengths `∫₀¹ ‖c'‖` of piecewise smooth paths `c : [0,1] → N` from `x`
  to `y` (any parameter interval gives the same infimum, by affine reparametrisation); `0` (Lean's
  `sInf ∅`) if there is none — never happens for the pairs `ω(t), ω'(t)` used in `d`.
* Derivatives are `deriv` of the extension (two-sided; at the finitely many break points and at
  `0, 1` the value is irrelevant for the integrals). `max_t` is `⨆ t ∈ [0,1]` (a real `iSup`, the
  maximum of a continuous function on `[0,1]`).
* The structure "with the metric d" is recorded as a `Dist` instance (`dist = d`) and the topology
  as the one generated by the open `d`-balls (for a metric this is the metric topology; no
  `MetricSpace` instance is built, which would require proving the metric axioms). -/
namespace RoundTrip.L2.Morse_PathSp

open scoped ContDiff unitInterval

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- `c` is piecewise smooth on `[0,1]`: `C^∞` on every closed subinterval of `[0,1]` whose
interior avoids a finite break set `S`. -/
def IsPWS (c : ℝ → V) : Prop :=
  ∃ S : Finset ℝ, ∀ a b : ℝ, 0 ≤ a → a < b → b ≤ 1 → (∀ s ∈ S, s ∉ Set.Ioo a b) →
    ContDiffOn ℝ ∞ c (Set.Icc a b)

/-- Arc length `∫₀¹ ‖c'(t)‖ dt`. -/
noncomputable def len (c : ℝ → V) : ℝ := ∫ t in (0 : ℝ)..1, ‖deriv c t‖

/-- The Riemannian distance `ρ(x, y)` of `N`: infimum of the lengths of the piecewise smooth
paths in `N` from `x` to `y`. -/
noncomputable def rho (N : Set V) (x y : V) : ℝ :=
  sInf {L | ∃ c : ℝ → V, IsPWS c ∧ (∀ t ∈ Set.Icc (0 : ℝ) 1, c t ∈ N) ∧ c 0 = x ∧ c 1 = y ∧
    len c = L}

/-- A path on `[0,1]` extended to `ℝ` (constant outside `[0,1]`). -/
noncomputable def ext (w : I → V) : ℝ → V := fun t => w (Set.projIcc 0 1 zero_le_one t)

/-- The textbook notion: the set `Ω(N; p, q)` of piecewise smooth paths `[0,1] → N` from `p` to
`q` (metric and topology below). -/
def T (N : Set V) (p q : V) : Type _ :=
  {w : I → V // IsPWS (ext w) ∧ (∀ t, w t ∈ N) ∧ w 0 = p ∧ w 1 = q}

/-- Milnor's metric `d(w, w') = max_t ρ(w(t), w'(t)) + (∫₀¹ (‖dw/dt‖ − ‖dw'/dt‖)² dt)^{1/2}`. -/
noncomputable def d {N : Set V} {p q : V} (w w' : T N p q) : ℝ :=
  (⨆ t : I, rho N (w.1 t) (w'.1 t)) +
    Real.sqrt (∫ t in (0 : ℝ)..1, (‖deriv (ext w.1) t‖ - ‖deriv (ext w'.1) t‖) ^ 2)

noncomputable instance (N : Set V) (p q : V) : Dist (T N p q) := ⟨d⟩

/-- The topology of `Ω`: generated by the open balls of `d`. -/
instance (N : Set V) (p q : V) : TopologicalSpace (T N p q) :=
  TopologicalSpace.generateFrom {U | ∃ (w : T N p q) (r : ℝ), U = {w' | d w w' < r}}

end RoundTrip.L2.Morse_PathSp
