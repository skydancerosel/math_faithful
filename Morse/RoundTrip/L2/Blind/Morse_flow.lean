import Morse
/-! Layer-2 blind definition of Morse_flow. Textbook: Milnor, *Morse Theory*, §2 (Lemma 2.4) and
§3, proof of Theorem 3.1, p. 12-13: the flow (1-parameter group) `φ_t` generated by the vector
field `X`: `φ_0 = id`, `d/dt φ_t(x) = X(φ_t(x))`; `t ↦ φ_t(x)` is the integral curve of `X`
through `x`.
Choices: the textbook has `X` smooth with compact support (so integral curves are unique and
defined for all `t`). `φ_t(x) = c(t)` for an integral curve `c` of `X` on the closed interval
between `0` and `t` (`uIcc 0 t`, derivatives within it, one-sided at the ends) with `c(0) = x`,
chosen by `Classical.choose` (unique on that interval for locally Lipschitz `X`). Outside the
textbook hypotheses: if no integral curve from `x` reaches time `t` (incomplete flow) the value
is `x`; if integral curves are not unique an arbitrary one is used. `φ_0(x) = x` always. -/
namespace RoundTrip.L2.Morse_flow

open Set

/-- The textbook notion: `φ_t(x)`, the value at time `t` of the integral curve of `X` from `x`. -/
noncomputable def T {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (X : E → E) (t : ℝ)
    (x : E) : E :=
  open Classical in
  if h : ∃ c : ℝ → E, c 0 = x ∧ ∀ s ∈ uIcc 0 t, HasDerivWithinAt c (X (c s)) (uIcc 0 t) s
  then Classical.choose h t else x

end RoundTrip.L2.Morse_flow
