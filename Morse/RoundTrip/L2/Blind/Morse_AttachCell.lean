import Morse
/-! Layer-2 blind definition of Morse_AttachCell. Textbook: Milnor, *Morse Theory*, §3, p. 13;
Hatcher, *Algebraic Topology*, ch. 0 (adjunction space `X ∪_φ eⁿ`: the quotient of the disjoint
union `X ⊔ Dⁿ` by `x ∼ φ(x)` for `x ∈ ∂Dⁿ = S^{n-1}`).
Choices: `Dⁿ` and `∂Dⁿ` are Mathlib's `TopCat.disk n` and `TopCat.diskBoundary n` (closed unit
ball and unit sphere of `ℝⁿ = EuclideanSpace ℝ (Fin n)`), `∂Dⁿ → Dⁿ` is
`TopCat.diskBoundaryInclusion n`. The space is built literally as a quotient of the topological
sum (Lean's `Quot`, i.e. by the equivalence relation generated by `b ∼ φ(b)`), with the quotient
topology. (`n = 0`: `∂D⁰ = ∅`, so this is `X ⊔ pt`.) -/
namespace RoundTrip.L2.Morse_AttachCell

open CategoryTheory TopCat

/-- The identification on `X ⊔ Dⁿ`: a boundary point `b ∈ ∂Dⁿ` (in `Dⁿ`) is glued to `φ b ∈ X`. -/
def Rel {n : ℕ} {X : TopCat.{0}} (φ : diskBoundary.{0} n ⟶ X) :
    (X ⊕ disk.{0} n) → (X ⊕ disk.{0} n) → Prop :=
  fun a c => ∃ b : diskBoundary.{0} n,
    a = Sum.inr ((diskBoundaryInclusion n).hom b) ∧ c = Sum.inl (φ.hom b)

/-- The textbook notion: `X ∪_φ eⁿ = (X ⊔ Dⁿ)/(b ∼ φ b)` with the quotient topology. -/
noncomputable def T {n : ℕ} {X : TopCat.{0}} (φ : diskBoundary.{0} n ⟶ X) : TopCat.{0} :=
  TopCat.of (Quot (Rel φ))

end RoundTrip.L2.Morse_AttachCell
