import Morse
/-! Layer-2 blind definition of Morse_MappingTelescope. Textbook: Milnor, *Morse Theory*, Appendix,
pp. 149-152; Hatcher, *Algebraic Topology*, §3.F/§4.G (mapping telescope of
`F₀ →c₀ F₁ →c₁ F₂ → ⋯`: the quotient of `∐ₙ Fₙ × [0,1]` by `(n, k, 1) ∼ (n+1, cₙ(k), 0)`).
Choices: the sequence of maps is read off the functor, `cₙ = F.map (n ⟶ n+1)`; the parameter
interval is `[0,1]` in every piece (Hatcher uses `[n, n+1]` in the `n`-th piece; the two are
homeomorphic by translation). The result type is a bare `Type`, so `T F` is the carrier: the
quotient (by the equivalence relation generated by the identifications, Lean's `Quot`) of the
`Σ`-type `Σ n, Fₙ × [0,1]`; the textbook (quotient of the disjoint-union/product) topology is
supplied separately as an instance below. -/
namespace RoundTrip.L2.Morse_MappingTelescope

open CategoryTheory
open scoped unitInterval

/-- The identification `(n, k, 1) ∼ (n+1, cₙ k, 0)` on `∐ₙ Fₙ × [0,1]`. -/
def Rel (F : ℕ ⥤ TopCat.{0}) : (Σ n : ℕ, F.obj n × I) → (Σ n : ℕ, F.obj n × I) → Prop :=
  fun a b => ∃ (n : ℕ) (k : F.obj n),
    a = ⟨n, (k, 1)⟩ ∧ b = ⟨n + 1, ((F.map (homOfLE (Nat.le_succ n))).hom k, 0)⟩

/-- The textbook notion: the mapping telescope (as a set: the quotient of `∐ₙ Fₙ × [0,1]`). -/
def T (F : ℕ ⥤ TopCat.{0}) : Type :=
  Quot (Rel F)

/-- Its textbook topology: the quotient topology of the disjoint union of the products. -/
instance (F : ℕ ⥤ TopCat.{0}) : TopologicalSpace (T F) :=
  inferInstanceAs (TopologicalSpace (Quot (Rel F)))

end RoundTrip.L2.Morse_MappingTelescope
